<Project>
	<PropertyGroup>
        <!-- Keep this list in ascending version order; the last entry drives regular tests. -->
        <UltimateAuthTargetFrameworks>net8.0;net9.0;net10.0</UltimateAuthTargetFrameworks>
        <UltimateAuthLatestTargetFramework>$([System.Text.RegularExpressions.Regex]::Match('$(UltimateAuthTargetFrameworks)', '[^;]+$').Value)</UltimateAuthLatestTargetFramework>
        <!-- CI may build a supported subset without retargeting single-target applications. -->
        <UltimateAuthBuildTargetFrameworks Condition="'$(UltimateAuthBuildTargetFrameworks)' == ''">$(UltimateAuthTargetFrameworks)</UltimateAuthBuildTargetFrameworks>

		<Version>0.2.0-preview.2</Version>
		<NoWarn>$(NoWarn);1591</NoWarn>
		
		<Authors>CodeBeam</Authors>
		<Company>CodeBeam</Company>

		<RepositoryUrl>https://github.com/CodeBeamOrg/UltimateAuth</RepositoryUrl>
		<PackageProjectUrl>https://ultimateauth.com</PackageProjectUrl>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>
</Project>