@inject IUAuthClient UAuthClient
@inject ISnackbar Snackbar

<MudDialog Class="lab-credential-dialog uauth-shared-dialog">
    <TitleContent>
        <div class="lab-credential-header">
            <div class="lab-credential-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.LockReset"
                         Size="Size.Medium" />
            </div>

            <div class="lab-credential-header-text">
                <MudText Typo="Typo.h6">
                    @(UserKey is null ? "Change Password" : "Set User Password")
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @(UserKey is null
                        ? "Update your account password securely."
                        : "Assign a new password to the selected identity.")
                </MudText>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" OnEnterPressed="ChangePasswordAsync">
            <div class="lab-credential-content">

                @if (PreviewMode)
                {
                    <MudAlert Severity="Severity.Info"
                              Variant="Variant.Outlined"
                              Dense="true">
                        Preview mode is active. Password changes are disabled.
                    </MudAlert>
                }

                @if (UserKey is not null)
                {
                    <MudAlert Severity="Severity.Warning"
                              Variant="Variant.Outlined"
                              Dense="true">
                        You are assigning a password to another user.
                        For better security and auditability, the credential
                        reset flow is generally recommended.
                    </MudAlert>
                }

                <div class="lab-credential-section">
                    <div class="lab-credential-section-heading">
                        <MudIcon Icon="@Icons.Material.Outlined.Key"
                                 Size="Size.Small"
                                 Color="Color.Primary" />
                        <div>
                            <strong>
                                @(UserKey is null ? "Password Update" : "New Credential")
                            </strong>
                            <span>
                                @(UserKey is null
                                    ? "Enter your current password and choose a new one."
                                    : "Choose the password to assign to this identity.")
                            </span>
                        </div>
                    </div>

                    <div class="lab-credential-fields">
                        @if (UserKey is null)
                        {
                            <MudPasswordField @bind-Value="_oldPassword"
                                              Label="Current Password"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              Required="true"
                                              RequiredError="Current password is required."
                                              Disabled="@_isSubmitting" />
                        }

                        <MudPasswordField @bind-Value="_newPassword"
                                          Label="New Password"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Required="true"
                                          RequiredError="New password is required."
                                          Disabled="@_isSubmitting" />

                        <MudPasswordField @bind-Value="_newPasswordCheck"
                                          Label="Confirm New Password"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Required="true"
                                          RequiredError="Please confirm the new password."
                                          Validation="@(new Func<string?, string?>(PasswordMatch))"
                                          Disabled="@_isSubmitting" />
                    </div>
                </div>

                <div class="lab-credential-hint">
                    <MudIcon Icon="@Icons.Material.Outlined.Info"
                             Size="Size.Small" />
                    <span>
                        Password requirements and credential reuse restrictions
                        are enforced by your UltimateAuth server configuration.
                    </span>
                </div>

                <div class="lab-credential-security-note">
                    <MudIcon Icon="@Icons.Material.Outlined.Security"
                             Color="Color.Primary"
                             Size="Size.Small" />
                    <div>
                        <strong>Security</strong>
                        <span>
                            Updating a password may affect active sessions
                            according to the configured session revocation policy.
                        </span>
                    </div>
                </div>

            </div>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <div class="lab-credential-actions">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Disabled="@_isSubmitting"
                       OnClick="Cancel">
                Cancel
            </MudButton>

            <MudLoadingButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Loading="@_isSubmitting"
                       Disabled="@(PreviewMode || _isSubmitting)"
                       OnClick="ChangePasswordAsync"
                       AutoDelay="0">
                @(UserKey is null ? "Change Password" : "Set Password")
            </MudLoadingButton>
        </div>
    </DialogActions>
</MudDialog>
