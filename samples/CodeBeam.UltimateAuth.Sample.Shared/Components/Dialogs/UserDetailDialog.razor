@using CodeBeam.UltimateAuth.Users.Contracts
@inject IUAuthClient UAuthClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog Class="lab-user-detail-dialog uauth-shared-dialog">
    <TitleContent>
        <div class="lab-user-detail-header">
            <div class="lab-user-detail-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.ManageAccounts"
                         Size="Size.Medium" />
            </div>
            <div class="lab-user-detail-header-text">
                <MudText Typo="Typo.h6">User Management</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Review identity details and manage account access.
                </MudText>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="lab-user-detail-content">
            @if (PreviewMode)
            {
                <MudAlert Severity="Severity.Info"
                          Variant="Variant.Outlined"
                          Dense="true">
                    Preview mode is active. User management actions are disabled.
                </MudAlert>
            }

            @if (_isLoading)
            {
                <MudProgressLinear Indeterminate="true"
                                   Color="Color.Primary" />
            }
            else if (_loadError is not null)
            {
                <MudAlert Severity="Severity.Error"
                          Variant="Variant.Outlined">
                    @_loadError
                </MudAlert>
            }
            else if (_user is not null || PreviewMode)
            {
                <div class="lab-user-detail-identity">
                    <div class="lab-user-detail-avatar">
                        <MudIcon Icon="@Icons.Material.Filled.Person"
                                 Size="Size.Large" />
                    </div>

                    <div class="lab-user-detail-identity-info">
                        <strong>@DisplayName</strong>
                        <span>@UserName</span>
                    </div>

                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@GetStatusColor(CurrentStatus)"
                             Variant="Variant.Outlined">
                        @CurrentStatus
                    </MudChip>
                </div>

                <div class="lab-user-detail-section-heading">
                    <strong>Identity Information</strong>
                    <span>Primary account information and registration details.</span>
                </div>

                <div class="lab-user-detail-info-grid">
                    <div class="lab-user-detail-info-item">
                        <span>Display Name</span>
                        <strong>@DisplayName</strong>
                    </div>

                    <div class="lab-user-detail-info-item">
                        <span>Username</span>
                        <strong>@UserName</strong>
                    </div>

                    <div class="lab-user-detail-info-item">
                        <span>Email</span>
                        <strong>@PrimaryEmail</strong>
                    </div>

                    <div class="lab-user-detail-info-item">
                        <span>Phone</span>
                        <strong>@PrimaryPhone</strong>
                    </div>

                    <div class="lab-user-detail-info-item">
                        <span>Created</span>
                        <strong>@CreatedAt</strong>
                    </div>

                    <div class="lab-user-detail-info-item">
                        <span>User Key</span>
                        <strong class="lab-user-detail-break">@UserKeyText</strong>
                    </div>
                </div>

                <MudDivider />

                <div class="lab-user-detail-section-heading">
                    <strong>Account Status</strong>
                    <span>Control whether this identity can access the application.</span>
                </div>

                <div class="lab-user-detail-status">
                    <MudSelect T="AdminAssignableUserStatus"
                               @bind-Value="_status"
                               Label="Account Status"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Disabled="@(_isSubmitting || PreviewMode)">
                        @foreach (var status in Enum.GetValues<AdminAssignableUserStatus>())
                        {
                            <MudSelectItem T="AdminAssignableUserStatus"
                                           Value="@status">
                                @status
                            </MudSelectItem>
                        }
                    </MudSelect>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Loading="@_isSubmitting"
                               Disabled="@(_isSubmitting || PreviewMode || !HasStatusChange)"
                               OnClick="ChangeStatusAsync">
                        Update Status
                    </MudButton>
                </div>

                <MudDivider />

                <div class="lab-user-detail-section-heading">
                    <strong>Management</strong>
                    <span>Manage the user's authentication and authorization settings.</span>
                </div>

                <div class="lab-user-detail-management">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.PersonOutline"
                               OnClick="OpenProfileAsync">
                        Profile
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AlternateEmail"
                               OnClick="OpenIdentifiersAsync">
                        Identifiers
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Key"
                               OnClick="OpenCredentialsAsync">
                        Credentials
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Devices"
                               OnClick="OpenSessionsAsync">
                        Sessions
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AdminPanelSettings"
                               OnClick="OpenRolesAsync">
                        Roles
                    </MudButton>
                </div>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <div class="lab-user-detail-actions">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Disabled="@_isSubmitting"
                       OnClick="Close">
                Close
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>
