@inject IUAuthClient UAuthClient
@inject ISnackbar Snackbar

<MudDialog Class="lab-permission-dialog uauth-shared-dialog">
    <TitleContent>
        <div class="lab-permission-header">
            <div class="lab-permission-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.Security"
                         Size="Size.Medium" />
            </div>
            <div class="lab-permission-header-text">
                <MudText Typo="Typo.h6">Role Permissions</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Configure permissions for @(PreviewMode ? PreviewRoleName : Role?.Name ?? "this role").
                </MudText>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="lab-permission-content">
            @if (PreviewMode)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Preview mode is active. You can explore permission selection, but changes cannot be saved.
                </MudAlert>
            }

            <div class="lab-permission-summary">
                <div>
                    <span>Selected Permissions</span>
                    <strong>@SelectedCount / @TotalCount</strong>
                </div>
                <MudProgressLinear Value="@SelectionPercentage"
                                   Color="Color.Primary"
                                   Rounded="true"
                                   Size="Size.Small" />
            </div>

            <div class="lab-permission-toolbar">
                <MudTextField T="string"
                              @bind-Value="_search"
                              Placeholder="Search permissions..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true" />

                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="ResetSelection">
                    Reset
                </MudButton>
            </div>

            <div class="lab-permission-groups">
                @foreach (var group in FilteredGroups)
                {
                    <div class="lab-permission-group" @key="group.Name">
                        <div class="lab-permission-group-header">
                            <MudCheckBox T="bool?"
                                         Value="@GetGroupState(group)"
                                         ValueChanged="@(value => ToggleGroup(group, value != true))"
                                         Color="Color.Primary"
                                         Size="Size.Small" />

                            <div class="lab-permission-group-heading">
                                <strong>@group.Name</strong>
                                <span>@group.Items.Count(x => x.Selected) of @group.Items.Count selected</span>
                            </div>

                            <MudIconButton Icon="@(group.Expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                           Size="Size.Small"
                                           OnClick="@(() => ToggleExpanded(group))"
                                           aria-label="Expand or collapse group" />
                        </div>

                        @if (group.Expanded)
                        {
                            <div class="lab-permission-items">
                                @foreach (var permission in GetVisibleItems(group))
                                {
                                    <div class="lab-permission-item" @key="permission.Value">
                                        <MudCheckBox T="bool"
                                                     Value="@permission.Selected"
                                                     ValueChanged="@(value => TogglePermission(permission, value))"
                                                     Color="Color.Primary"
                                                     Size="Size.Small" />
                                        <span>@permission.Value</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (FilteredGroups.Count == 0)
                {
                    <div class="lab-permission-empty">
                        <MudIcon Icon="@Icons.Material.Outlined.SearchOff"
                                 Color="Color.Secondary"
                                 Size="Size.Large" />
                        <strong>No permissions found</strong>
                        <span>Try a different search term.</span>
                    </div>
                }
            </div>

            <div class="lab-permission-hint">
                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                <span>
                    Permission groups are organized by resource.
                    Selecting a group selects its catalog permissions.
                    Changes take effect according to the authorization evaluation and caching policies of the application.
                </span>
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="lab-permission-actions">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Disabled="@_isSaving"
                       OnClick="Cancel">
                Cancel
            </MudButton>

            <MudLoadingButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Loading="@_isSaving"
                       Disabled="@(PreviewMode || _isSaving || !HasChanges)"
                       OnClick="SaveAsync"
                       AutoDelay="0">
                Save Permissions
            </MudLoadingButton>
        </div>
    </DialogActions>
</MudDialog>
