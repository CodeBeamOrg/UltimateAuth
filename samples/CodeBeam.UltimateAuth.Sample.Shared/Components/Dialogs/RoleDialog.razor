@using CodeBeam.UltimateAuth.Authorization.Contracts
@using CodeBeam.UltimateAuth.Core.Contracts
@inject IUAuthClient UAuthClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog Class="lab-role-dialog uauth-shared-dialog">
    <TitleContent>
        <div class="lab-role-header">
            <div class="lab-role-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings"
                         Size="Size.Medium" />
            </div>
            <div class="lab-role-header-text">
                <MudText Typo="Typo.h6">Role Management</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Create roles and manage their permissions.
                </MudText>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="lab-role-content">
            @if (PreviewMode)
            {
                <MudAlert Severity="Severity.Info"
                          Variant="Variant.Outlined"
                          Dense="true">
                    Preview mode is active. Role changes are disabled.
                </MudAlert>
            }

            <div class="lab-role-toolbar">
                <div class="lab-role-section-heading">
                    <strong>System Roles</strong>
                    <span>Roles available in the authorization system.</span>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="@(_loading || PreviewMode)"
                               OnClick="ReloadAsync"
                               aria-label="Refresh roles" />
            </div>

            @if (PreviewMode)
            {
                <div class="lab-role-list">
                    @foreach (var role in _previewRoles)
                    {
                        <div class="lab-role-card" @key="role.Name">
                            <div class="lab-role-card-main">
                                <div class="lab-role-card-icon">
                                    <MudIcon Icon="@Icons.Material.Filled.Shield"
                                             Size="Size.Small" />
                                </div>
                                <div class="lab-role-card-info">
                                    <strong>@role.Name</strong>
                                    <span>@role.Description</span>
                                </div>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="Color.Primary"
                                         Variant="Variant.Outlined">
                                    @role.PermissionCount permissions
                                </MudChip>
                            </div>
                            <div class="lab-role-card-actions">
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           Disabled="true">
                                    Rename
                                </MudButton>
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           Disabled="true">
                                    Permissions
                                </MudButton>
                                <MudSpacer />
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Disabled="true" />
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <MudDataGrid @ref="_grid"
                             T="RoleInfo"
                             ServerData="LoadServerData"
                             Loading="@_loading"
                             Hover="true"
                             Dense="true"
                             Elevation="0"
                             Bordered="false"
                             Striped="false"
                             ReadOnly="true"
                             Filterable="false"
                             Class="lab-role-grid">
                    <Columns>
                        <TemplateColumn Title="Role">
                            <CellTemplate>
                                <div class="lab-role-grid-name">
                                    <MudIcon Icon="@Icons.Material.Filled.Shield"
                                             Color="Color.Primary"
                                             Size="Size.Small" />
                                    <strong>@context.Item.Name</strong>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn Title="Permissions">
                            <CellTemplate>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Variant="Variant.Outlined"
                                         Color="Color.Primary">
                                    @GetPermissionCount(context.Item)
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn Title="Wildcard">
                            <CellTemplate>
                                @if (context.Item.Permissions.Any(x => x.IsWildcard))
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Warning"
                                             Variant="Variant.Outlined">
                                        Wildcard
                                    </MudChip>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption">—</MudText>
                                }
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn Title="Actions">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="1">
                                    <MudTooltip Text="Rename Role">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Disabled="@_loading"
                                                       OnClick="@(() => BeginRename(context.Item))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Manage Permissions">
                                        <MudIconButton Icon="@Icons.Material.Filled.Security"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Disabled="@_loading"
                                                       OnClick="@(() => EditPermissions(context.Item))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Delete Role">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       Disabled="@_loading"
                                                       OnClick="@(() => DeleteRoleAsync(context.Item))" />
                                    </MudTooltip>
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>

                    <PagerContent>
                        <MudDataGridPager T="RoleInfo"
                                          PageSizeOptions="new int[] { 5, 10, 20 }" />
                    </PagerContent>
                </MudDataGrid>
            }

            @if (_editingRole is not null)
            {
                <div class="lab-role-edit">
                    <div class="lab-role-section-heading">
                        <strong>Rename Role</strong>
                        <span>Change the role name without changing its permissions.</span>
                    </div>
                    <MudTextField @bind-Value="_editingName"
                                  Label="Role Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Disabled="@_loading" />
                    <div class="lab-role-edit-actions">
                        <MudButton Variant="Variant.Text"
                                   Disabled="@_loading"
                                   OnClick="CancelRename">
                            Cancel
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@_loading"
                                   OnClick="SaveRenameAsync">
                            Save Name
                        </MudButton>
                    </div>
                </div>
            }

            <MudDivider />

            <div class="lab-role-section-heading">
                <strong>Create Role</strong>
                <span>Add a new role to the authorization system.</span>
            </div>

            <div class="lab-role-create">
                <MudTextField @bind-Value="_newRoleName"
                              Label="Role Name"
                              Placeholder="e.g. ContentEditor"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="100"
                              Disabled="@(_loading || PreviewMode)" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@(_loading || PreviewMode || string.IsNullOrWhiteSpace(_newRoleName))"
                           OnClick="CreateRoleAsync">
                    Create Role
                </MudButton>
            </div>

            <div class="lab-role-hint">
                <MudIcon Icon="@Icons.Material.Outlined.Info"
                         Size="Size.Small" />
                <span>
                    Roles define authorization groups. Permissions can be
                    configured after creating a role.
                </span>
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="lab-role-actions">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Disabled="@_loading"
                       OnClick="Close">
                Close
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>
