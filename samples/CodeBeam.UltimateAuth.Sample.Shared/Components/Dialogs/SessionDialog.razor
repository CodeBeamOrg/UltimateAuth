@using CodeBeam.UltimateAuth.Core.Contracts
@using CodeBeam.UltimateAuth.Core.Domain
@using CodeBeam.UltimateAuth.Users.Contracts
@inject IUAuthClient UAuthClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

<MudDialog Class="lab-session-dialog uauth-shared-dialog">
    <TitleContent>
        <div class="lab-session-header">
            <div class="lab-session-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.Devices"
                         Size="Size.Medium" />
            </div>
            <div class="lab-session-header-text">
                <MudText Typo="Typo.h6">Session Management</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Review connected devices, session activity and access.
                </MudText>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="lab-session-content">
            @if (PreviewMode)
            {
                <MudAlert Severity="Severity.Info"
                          Variant="Variant.Outlined"
                          Dense="true">
                    Preview mode is active. Session actions are disabled.
                </MudAlert>
            }

            @if (_chainDetail is not null)
            {
                <div class="lab-session-detail-toolbar">
                    <MudButton Variant="Variant.Text"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="ClearDetail">
                        All Devices
                    </MudButton>

                    @if (!_chainDetail.IsRevoked)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Block"
                                   Disabled="@_loading"
                                   OnClick="@(() => RevokeChainAsync(_chainDetail.ChainId))">
                            Revoke Device
                        </MudButton>
                    }
                </div>

                <div class="lab-session-section-heading">
                    <strong>Device Details</strong>
                    <span>Information recorded for this authentication chain.</span>
                </div>

                <div class="lab-session-detail-grid">
                    <div class="lab-session-detail-item">
                        <span>Device Type</span>
                        <strong>@_chainDetail.DeviceType</strong>
                    </div>
                    <div class="lab-session-detail-item">
                        <span>Platform</span>
                        <strong>@_chainDetail.Platform</strong>
                    </div>
                    <div class="lab-session-detail-item">
                        <span>Operating System</span>
                        <strong>@_chainDetail.OperatingSystem</strong>
                    </div>
                    <div class="lab-session-detail-item">
                        <span>Browser</span>
                        <strong>@_chainDetail.Browser</strong>
                    </div>
                    <div class="lab-session-detail-item">
                        <span>Created</span>
                        <strong>@_chainDetail.CreatedAt.ToLocalTime().ToString("g")</strong>
                    </div>
                    <div class="lab-session-detail-item">
                        <span>Last Seen</span>
                        <strong>@_chainDetail.LastSeenAt.ToLocalTime().ToString("g")</strong>
                    </div>
                    <div class="lab-session-detail-item">
                        <span>State</span>
                        <strong>@_chainDetail.State</strong>
                    </div>
                    <div class="lab-session-detail-item">
                        <span>Active Session</span>
                        <strong class="lab-session-break">@_chainDetail.ActiveSessionId</strong>
                    </div>
                    <div class="lab-session-detail-item">
                        <span>Rotation Count</span>
                        <strong>@_chainDetail.RotationCount</strong>
                    </div>
                    <div class="lab-session-detail-item">
                        <span>Touch Count</span>
                        <strong>@_chainDetail.TouchCount</strong>
                    </div>
                </div>

                <MudDivider />

                <div class="lab-session-section-heading">
                    <strong>Session History</strong>
                    <span>Sessions associated with this device chain.</span>
                </div>

                <div class="lab-session-history">

                    @foreach (var session in _chainDetail.Sessions
                        .OrderByDescending(x => x.CreatedAt)
                        .Skip((_sessionPage - 1) * SessionPageSize)
                        .Take(SessionPageSize))
                    {
                        // Mevcut lab-session-history-item içeriği
                    }

                    <MudPagination Count="@Math.Max(1,
                                       (_chainDetail.Sessions.Count() + SessionPageSize - 1)
                                       / SessionPageSize)"
                                   Selected="@_sessionPage"
                                   SelectedChanged="@((int page) => _sessionPage = page)"
                                   Color="Color.Primary" />


                    @foreach (var session in _chainDetail.Sessions)
                    {
                        <div class="lab-session-history-item">
                            <div class="lab-session-history-top">
                                <span class="lab-session-break">
                                    @session.SessionId
                                </span>

                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@(session.IsRevoked ? Color.Error : Color.Success)"
                                         Variant="Variant.Outlined">
                                    @(session.IsRevoked ? "Revoked" : "Not Revoked")
                                </MudChip>
                            </div>
                            <div class="lab-session-history-dates">
                                <span>Created: @session.CreatedAt.ToLocalTime().ToString("g")</span>
                                <span>Expires: @session.ExpiresAt.ToLocalTime().ToString("g")</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="lab-session-section-heading">
                    <strong>Device Access</strong>
                    <span>Manage active device chains and terminate access when needed.</span>
                </div>

                <div class="lab-session-bulk-actions">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="@(_loading || PreviewMode)"
                               OnClick="LogoutAllAsync">
                        Logout All
                    </MudButton>

                    @if (UserKey is null)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="@(_loading || PreviewMode)"
                                   OnClick="LogoutOthersAsync">
                            Logout Others
                        </MudButton>
                    }

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               Size="Size.Small"
                               Disabled="@(_loading || PreviewMode)"
                               OnClick="RevokeAllAsync">
                        Revoke All
                    </MudButton>

                    @if (UserKey is null)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Disabled="@(_loading || PreviewMode)"
                                   OnClick="RevokeOthersAsync">
                            Revoke Others
                        </MudButton>
                    }
                </div>

                <MudDivider />

                <div class="lab-session-list-heading">
                    <div class="lab-session-section-heading">
                        <strong>Connected Devices</strong>
                        <span>Authentication chains associated with this identity.</span>
                    </div>

                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="@(_loading || PreviewMode)"
                                   OnClick="ReloadAsync"
                                   aria-label="Refresh sessions" />
                </div>

                @if (PreviewMode)
                {
                    <div class="lab-session-device-list">
                        @foreach (var device in _previewDevices)
                        {
                            <div class="lab-session-device-card">
                                <div class="lab-session-device-top">
                                    <div class="lab-session-device-icon">
                                        <MudIcon Icon="@device.Icon"
                                                 Size="Size.Medium" />
                                    </div>
                                    <div class="lab-session-device-info">
                                        <strong>@device.Name</strong>
                                        <span>@device.Platform · @device.Browser</span>
                                    </div>
                                    @if (device.IsCurrent)
                                    {
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="Color.Primary"
                                                 Variant="Variant.Outlined">
                                            Current
                                        </MudChip>
                                    }
                                </div>
                                <div class="lab-session-device-bottom">
                                    <span>Last seen: @device.LastSeen</span>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               Disabled="true">
                                        Details
                                    </MudButton>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <MudDataGrid @ref="_grid"
                                 T="SessionChainSummary"
                                 ServerData="LoadServerData"
                                 Loading="@_loading"
                                 Dense="true"
                                 Hover="true"
                                 Elevation="0"
                                 Bordered="false"
                                 Striped="false"
                                 Filterable="false"
                                 ReadOnly="true"
                                 Class="lab-session-grid">
                        <Columns>
                            <TemplateColumn Title="Device">
                                <CellTemplate>
                                    <div class="lab-session-grid-device">
                                        <strong>@context.Item.OperatingSystem</strong>
                                        <span>@context.Item.Platform · @context.Item.Browser</span>
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>

                            <TemplateColumn Title="State">
                                <CellTemplate>
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Variant="Variant.Outlined">
                                        @context.Item.State
                                    </MudChip>
                                </CellTemplate>
                            </TemplateColumn>

                            <TemplateColumn Title="Current">
                                <CellTemplate>
                                    @if (context.Item.IsCurrentDevice)
                                    {
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="Color.Primary"
                                                 Variant="Variant.Outlined">
                                            Current
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption">—</MudText>
                                    }
                                </CellTemplate>
                            </TemplateColumn>

                            <PropertyColumn Property="x => x.LastSeenAt"
                                            Title="Last Seen"
                                            Editable="false" />

                            <TemplateColumn Title="Actions">
                                <CellTemplate>
                                    <MudStack Row="true" Spacing="1">
                                        <MudTooltip Text="Device Details">
                                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                           Size="Size.Small"
                                                           Color="Color.Primary"
                                                           Disabled="@_loading"
                                                           OnClick="@(() => ShowChainDetailsAsync(context.Item.ChainId))" />
                                        </MudTooltip>
                                        <MudTooltip Text="Logout Device">
                                            <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                                           Size="Size.Small"
                                                           Disabled="@_loading"
                                                           OnClick="@(() => LogoutDeviceAsync(context.Item.ChainId))" />
                                        </MudTooltip>
                                        <MudTooltip Text="Revoke Device">
                                            <MudIconButton Icon="@Icons.Material.Filled.Block"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           Disabled="@_loading"
                                                           OnClick="@(() => RevokeChainAsync(context.Item.ChainId))" />
                                        </MudTooltip>
                                    </MudStack>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>

                        <PagerContent>
                            <MudDataGridPager T="SessionChainSummary"
                                              PageSizeOptions="new int[] { 5, 10, 20 }" />
                        </PagerContent>
                    </MudDataGrid>
                }
            }
        </div>
    </DialogContent>

    <DialogActions>
        <div class="lab-session-footer">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Disabled="@_loading"
                       OnClick="Cancel">
                Close
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>
