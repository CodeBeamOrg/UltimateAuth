@using CodeBeam.UltimateAuth.Users.Contracts
@inject IUAuthClient UAuthClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog Class="lab-identifier-dialog uauth-shared-dialog">
    <TitleContent>
        <div class="lab-identifier-header">
            <div class="lab-identifier-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.AlternateEmail"
                         Size="Size.Medium" />
            </div>
            <div class="lab-identifier-header-text">
                <MudText Typo="Typo.h6">Manage Identifiers</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Manage usernames, email addresses and other sign-in identifiers.
                </MudText>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="lab-identifier-content">
            @if (PreviewMode)
            {
                <MudAlert Severity="Severity.Info"
                          Variant="Variant.Outlined"
                          Dense="true">
                    Preview mode is active. Identifier changes are disabled.
                </MudAlert>
            }

            <div class="lab-identifier-toolbar">
                <div class="lab-identifier-section-heading">
                    <strong>Linked Identifiers</strong>
                    <span>Identifiers associated with this identity.</span>
                </div>

                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="@(_loading || PreviewMode)"
                               OnClick="ReloadAsync"
                               aria-label="Refresh identifiers" />
            </div>

            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_loadError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    @_loadError
                </MudAlert>
            }
            else if (_identifiers.Count == 0)
            {
                <div class="lab-identifier-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.AlternateEmail"
                             Size="Size.Large"
                             Color="Color.Secondary" />
                    <strong>No identifiers found</strong>
                    <span>No identifiers are currently available for this identity.</span>
                </div>
            }
            else
            {
                <div class="lab-identifier-list">
                    @foreach (var identifier in _identifiers)
                    {
                        <div class="lab-identifier-card" @key="identifier.Id">
                            <div class="lab-identifier-card-main">
                                <div class="lab-identifier-type-icon">
                                    <MudIcon Icon="@GetIdentifierIcon(identifier.Type)"
                                             Size="Size.Small" />
                                </div>

                                <div class="lab-identifier-card-details">
                                    <div class="lab-identifier-card-label">
                                        <strong>@identifier.Type</strong>

                                        @if (identifier.IsPrimary)
                                        {
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="Color.Primary"
                                                     Variant="Variant.Outlined">
                                                Primary
                                            </MudChip>
                                        }
                                    </div>

                                    <span class="lab-identifier-value">
                                        @identifier.Value
                                    </span>

                                    <div class="lab-identifier-status">
                                        @if (identifier.IsVerified)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Verified"
                                                     Color="Color.Success"
                                                     Size="Size.Small" />
                                            <span>Verified</span>
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Outlined.Info"
                                                     Color="Color.Warning"
                                                     Size="Size.Small" />
                                            <span>Not verified</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="lab-identifier-card-actions">
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           Color="Color.Primary"
                                           Disabled="@(_loading || PreviewMode)"
                                           OnClick="@(() => BeginEdit(identifier))">
                                    Edit
                                </MudButton>

                                @if (identifier.IsPrimary)
                                {
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               Disabled="@(_loading || PreviewMode)"
                                               OnClick="@(() => UnsetPrimaryAsync(identifier.Id))">
                                        Unset Primary
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               Disabled="@(_loading || PreviewMode)"
                                               OnClick="@(() => SetPrimaryAsync(identifier.Id))">
                                        Set Primary
                                    </MudButton>
                                }

                                @if (!identifier.IsVerified)
                                {
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               Color="Color.Primary"
                                               Disabled="@(_loading || PreviewMode)"
                                               OnClick="@(() => VerifyAsync(identifier.Id))">
                                        Verify
                                    </MudButton>
                                }

                                <MudSpacer />

                                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               Disabled="@(_loading || PreviewMode)"
                                               OnClick="@(() => DeleteIdentifierAsync(identifier.Id))"
                                               aria-label="Delete identifier" />
                            </div>

                            @if (_editingId == identifier.Id)
                            {
                                <div class="lab-identifier-edit">
                                    <MudTextField @bind-Value="_editingValue"
                                                  Label="Identifier Value"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Disabled="@_loading" />

                                    <div class="lab-identifier-edit-actions">
                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Text"
                                                   Disabled="@_loading"
                                                   OnClick="CancelEdit">
                                            Cancel
                                        </MudButton>
                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Disabled="@_loading"
                                                   OnClick="SaveEditAsync">
                                            Save
                                        </MudButton>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <MudDivider />

            <div class="lab-identifier-section-heading">
                <strong>Add Identifier</strong>
                <span>Attach an additional identifier to this account.</span>
            </div>

            <div class="lab-identifier-add">
                <MudSelectExtended T="UserIdentifierType"
                                   @bind-Value="_newIdentifierType"
                                   ItemCollection="@_identifierTypes"
                                   Label="Identifier Type"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Disabled="@(_loading || PreviewMode)" />

                <MudTextField @bind-Value="_newIdentifierValue"
                              Label="Identifier Value"
                              Placeholder="Enter username, email or phone"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Disabled="@(_loading || PreviewMode)" />

                <div class="lab-identifier-add-footer">
                    <MudSwitchM3 @bind-Value="_newIdentifierPrimary"
                                 Label="Set as primary"
                                 Color="Color.Primary"
                                 Disabled="@(_loading || PreviewMode)" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@(_loading || PreviewMode)"
                               OnClick="AddNewIdentifierAsync">
                        Add Identifier
                    </MudButton>
                </div>
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="lab-identifier-footer">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Disabled="@_loading"
                       OnClick="Cancel">
                Close
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>
