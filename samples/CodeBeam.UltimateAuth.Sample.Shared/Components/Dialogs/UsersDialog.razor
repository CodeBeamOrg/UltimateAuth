@using CodeBeam.UltimateAuth.Core.Contracts
@using CodeBeam.UltimateAuth.Users.Contracts
@inject IUAuthClient UAuthClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog Class="lab-users-dialog uauth-shared-dialog">
    <TitleContent>
        <div class="lab-users-header">
            <div class="lab-users-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.People"
                         Size="Size.Medium" />
            </div>
            <div class="lab-users-header-text">
                <MudText Typo="Typo.h6">User Management</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Browse identities, manage access and create users.
                </MudText>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="lab-users-content">
            @if (PreviewMode)
            {
                <MudAlert Severity="Severity.Info"
                          Variant="Variant.Outlined"
                          Dense="true">
                    Preview mode is active. User records are examples
                    and cannot be modified.
                </MudAlert>
            }

            <div class="lab-users-toolbar">
                <div class="lab-users-section-heading">
                    <strong>Users</strong>
                    <span>Search and manage registered identities.</span>
                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           Disabled="@_loading"
                           OnClick="OpenCreateUserAsync">
                    New User
                </MudButton>
            </div>

            <div class="lab-users-filters">
                <MudTextField T="string"
                              Value="@_search"
                              ValueChanged="OnSearchChanged"
                              Placeholder="Search users..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Clearable="true" />

                <MudSelect T="UserStatus?"
                           Value="@_statusFilter"
                           ValueChanged="OnStatusChanged"
                           Label="Status"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    <MudSelectItem T="UserStatus?" Value="@((UserStatus?)null)">
                        All Statuses
                    </MudSelectItem>
                    @foreach (var status in Enum.GetValues<UserStatus>())
                    {
                        <MudSelectItem T="UserStatus?"
                                       Value="@((UserStatus?)status)">
                            @status
                        </MudSelectItem>
                    }
                </MudSelect>
            </div>

            @if (PreviewMode)
            {
                <div class="lab-users-list">
                    @foreach (var user in FilteredPreviewUsers)
                    {
                        <div class="lab-users-card" @key="user.Key">
                            <div class="lab-users-card-main">
                                <div class="lab-users-avatar">
                                    <MudIcon Icon="@Icons.Material.Filled.Person"
                                             Size="Size.Medium" />
                                </div>

                                <div class="lab-users-card-info">
                                    <strong>@user.DisplayName</strong>
                                    <span>@user.UserName</span>
                                    <span>@user.Email</span>
                                </div>

                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@GetStatusColor(user.Status)"
                                         Variant="Variant.Outlined">
                                    @user.Status
                                </MudChip>
                            </div>

                            <div class="lab-users-card-actions">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Created @user.CreatedAt
                                </MudText>

                                <MudSpacer />

                                <MudButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.ManageAccounts"
                                           OnClick="OpenPreviewUserAsync">
                                    Manage
                                </MudButton>

                                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Disabled="true"
                                               aria-label="Delete user" />
                            </div>
                        </div>
                    }

                    @if (FilteredPreviewUsers.Count == 0)
                    {
                        <div class="lab-users-empty">
                            <MudIcon Icon="@Icons.Material.Outlined.PersonSearch"
                                     Size="Size.Large"
                                     Color="Color.Secondary" />
                            <strong>No users found</strong>
                            <span>Try another search or status filter.</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <MudDataGrid @ref="_grid"
                             T="UserSummary"
                             ServerData="LoadUsers"
                             Loading="@_loading"
                             Dense="true"
                             Hover="true"
                             Elevation="0"
                             Bordered="false"
                             Striped="false"
                             Filterable="false"
                             ReadOnly="true"
                             Class="lab-users-grid">
                    <Columns>
                        <TemplateColumn Title="User">
                            <CellTemplate>
                                <div class="lab-users-grid-identity">
                                    <strong>@context.Item.DisplayName</strong>
                                    <span>@context.Item.UserName</span>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>

                        <PropertyColumn Property="x => x.PrimaryEmail"
                                        Title="Email"
                                        Editable="false" />

                        <TemplateColumn Title="Status">
                            <CellTemplate>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Variant="Variant.Outlined"
                                         Color="@GetStatusColor(context.Item.Status)">
                                    @context.Item.Status
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn Title="Actions">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="1">
                                    <MudTooltip Text="Manage User">
                                        <MudIconButton Icon="@Icons.Material.Filled.ManageAccounts"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Disabled="@_loading"
                                                       OnClick="@(() => OpenUserAsync(context.Item.UserKey))" />
                                    </MudTooltip>

                                    <MudTooltip Text="Delete User">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       Disabled="@_loading"
                                                       OnClick="@(() => DeleteUserAsync(context.Item))" />
                                    </MudTooltip>
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>

                    <PagerContent>
                        <MudDataGridPager T="UserSummary"
                                          PageSizeOptions="new int[] { 5, 10, 20, 50 }" />
                    </PagerContent>
                </MudDataGrid>
            }

            <div class="lab-users-hint">
                <MudIcon Icon="@Icons.Material.Outlined.Info"
                         Size="Size.Small" />
                <span>
                    User management actions are subject to server-side
                    authorization. Deleting a user uses soft deletion.
                </span>
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="lab-users-actions">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Disabled="@_loading"
                       OnClick="Close">
                Close
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>
