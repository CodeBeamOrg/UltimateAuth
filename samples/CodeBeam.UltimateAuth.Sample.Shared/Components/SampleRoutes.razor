@using System.Reflection
@using CodeBeam.UltimateAuth.Sample.Shared.Components.Page
@using CodeBeam.UltimateAuth.Sample.Shared.Infrastructure
@implements IDisposable

@inject ISnackbar Snackbar
@inject DarkModeManager DarkModeManager

<CascadingValue Value="DarkModeManager" IsFixed="true">
    <UAuthApp OnReauthRequired="HandleReauth" UseBuiltInRouter="true" AppAssembly="@AppAssembly" DefaultLayout="@DefaultLayout">

        <ChildContent>
            <MudThemeProvider IsDarkMode="@DarkModeManager.IsDarkMode" />
            <MudPopoverProvider />
            <MudDialogProvider />
            <MudSnackbarProvider />
        </ChildContent>

        @* Advanced: you can fully control routing by providing your own Router in UAuthApp component. *@
    @* <UAuthApp OnReauthRequired="HandleReauth">
        <MudThemeProvider IsDarkMode="@DarkModeManager.IsDarkMode" />
        <MudPopoverProvider />
        <MudDialogProvider />
        <MudSnackbarProvider />

        <Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="UAuthAssemblies.Client()">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                    <NotAuthorized>
                        <NotAuthorized />
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </Found>
        </Router>
    </UAuthApp> *@

        <NotAuthorized>
            <NotAuthorized />
        </NotAuthorized>

    </UAuthApp>
</CascadingValue>

@code {
    [Parameter, EditorRequired]
    public Assembly AppAssembly { get; set; } = default!;

    [Parameter, EditorRequired]
    public Type DefaultLayout { get; set; } = default!;

    private Task HandleReauth()
    {
        Snackbar.Add("Reauthentication required. Please log in again.", Severity.Warning);
        return Task.CompletedTask;
    }

    protected override void OnInitialized()
    {
        DarkModeManager.Changed += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await DarkModeManager.InitializeAsync();
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        DarkModeManager.Changed -= OnThemeChanged;
    }
}
