@inject IUAuthClient UAuthClient
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudLayout>
    <MudAppBar Class="uauth-blur" Color="Color.Transparent" Dense="true" Elevation="0">
        <UAuthLogo />
        <MudText Class="ml-2 cursor-pointer" Style="user-select: none" @onclick="@(() => Nav.NavigateTo("/home", true))"><b>UltimateAuth</b></MudText>
        <MudDivider Class="ml-3 mr-1" Vertical="true" />
        <MudText Class="ml-2" Style="line-height: 14px" Typo="Typo.subtitle2">@Title</MudText>

        <MudSpacer />

        <MudMenu Dense="true" PopoverClass="uauth-menu-popover" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">

            <ActivatorContent>
                <MudButton Class="d-none d-sm-flex" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Security" EndIcon="@Icons.Material.Filled.ArrowDropDown" OnClick="@context.ToggleAsync">
                    Authorization Lab
                </MudButton>

                <MudIconButton Class="d-flex d-sm-none" Icon="@Icons.Material.Outlined.Security" Color="Color.Inherit" Size="Size.Medium" OnClick="@context.ToggleAsync" aria-label="Authorization Lab" />
            </ActivatorContent>

            <ChildContent>
                <MudText Typo="Typo.subtitle2" Class="px-4 pt-3 pb-1">
                    <b>Authorization Lab</b>
                </MudText>

                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-4 pb-2">
                    Explore route and UI authorization.
                </MudText>

                <MudDivider />

                <MudText Typo="Typo.overline" Class="px-4 pt-2">ROUTE PROTECTION</MudText>

                <MudMenuItem Icon="@Icons.Material.Outlined.Public" Label="Public Page" Href="/samples/auth/public" />
                <MudMenuItem Icon="@Icons.Material.Outlined.Lock" Label="Authenticated Page" Href="/samples/auth/authenticated" />
                <MudMenuItem Icon="@Icons.Material.Outlined.AdminPanelSettings" Label="Admin Role" Href="/samples/auth/admin" />
                <MudMenuItem Icon="@Icons.Material.Outlined.Security" Label="Admin Permission" Href="/samples/auth/permission-admin" />

                <MudDivider />

                <MudText Typo="Typo.overline" Class="px-4 pt-2">AUTHORIZATION MODELS</MudText>

                <MudMenuItem Icon="@Icons.Material.Outlined.Rule" Label="Match Modes" Href="/samples/auth/match-modes" />
                <MudMenuItem Icon="@Icons.Material.Outlined.VerifiedUser" Label="ASP.NET Core Authorize" Href="/samples/auth/aspnet" />
                <MudMenuItem Icon="@Icons.Material.Outlined.Layers" Label="Combined Authorization" Href="/samples/auth/combined" />

                <MudDivider />

                <MudText Typo="Typo.overline" Class="px-4 pt-2">COMPONENT AUTHORIZATION</MudText>

                <MudMenuItem Icon="@Icons.Material.Outlined.ViewQuilt" Label="UAuthStateView" Href="/samples/auth/state-view" />
            </ChildContent>
        </MudMenu>

        <MudIconButton Icon="@(DarkModeManager.IsDarkMode? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" OnClick="@(() => DarkModeManager.ToggleAsync())" />

        <UAuthStateView>
            <Authorized Context="state">
                <MudMenu PopoverClass="mud-theme-primary uauth-menu-popover" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <div @onclick="@(() => context.ToggleAsync())">
                            <MudBadge Overlap="true" Dot="true" Color="@GetBadgeColor()">
                                <MudAvatar Class="cursor-pointer mud-ripple" Variant="Variant.Filled" Color="Color.Primary">
                                    <MudText Typo="Typo.subtitle2">@((state.Identity?.DisplayName ?? "?").Trim() is var n ? (n.Length >= 2 ? n[..2] : n[..1]) : "?")</MudText>
                                </MudAvatar>
                            </MudBadge>
                        </div>
                    </ActivatorContent>

                    <ChildContent>
                        <MudText Class="px-4 py-2"><b>@state.Identity?.DisplayName</b></MudText>
                        <MudText Class="px-4" Typo="Typo.subtitle2">@string.Join(", ", state.Claims.Roles)</MudText>

                        <MudDivider />

                        <MudMenuItem Icon="@Icons.Material.Filled.Refresh" IconColor="Color.Secondary" Label="Refresh Session" OnClick="@Refresh" />
                        <MudMenuItem Icon="@Icons.Material.Filled.VerifiedUser" IconColor="Color.Secondary" Label="Validate Session" OnClick="@Validate" />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Secondary" Label="Logout" OnClick="@Logout" />

                        @if (state.Identity?.SessionState is not null && state.Identity.SessionState != SessionState.Active)
                        {
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Filled.Login" Label="Reauthenticate" OnClick="@GoToLoginWithReturn" />
                        }
                    </ChildContent>
                </MudMenu>
            </Authorized>

            <NotAuthorized>
                <MudChip T="string" Style="width: fit-content" Text="Sign In" Color="Color.Primary" Variant="Variant.Filled" Class="cursor-pointer" OnClick="@HandleSignInClick" />
            </NotAuthorized>
        </UAuthStateView>
    </MudAppBar>

    <MudMainContent>
        @ChildContent
    </MudMainContent>
</MudLayout>
