        <a class="brand" href="/"><span class="brand-mark">U</span><strong>UltimateAuth</strong></a>
        <MudSpacer />
        <MudLink Href="/" Underline="Underline.None">Playground</MudLink>
        <MudLink Href="https://ultimateauth.com" Target="_blank" Underline="Underline.None">Documentation</MudLink>
        <MudLink Href="https://github.com/CodeBeamOrg/UltimateAuth" Target="_blank" Underline="Underline.None">GitHub ↗</MudLink>
