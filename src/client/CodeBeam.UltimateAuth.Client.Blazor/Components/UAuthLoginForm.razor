@namespace CodeBeam.UltimateAuth.Client.Blazor

@using CodeBeam.UltimateAuth.Client.Options
@using CodeBeam.UltimateAuth.Core.Defaults
@using CodeBeam.UltimateAuth.Core.Contracts
@using Microsoft.Extensions.Options

@inject IJSRuntime JS
@inject IOptions<UAuthClientOptions> Options
@inject NavigationManager Navigation

<form @ref="_form"
      method="post"
      action="@ResolvedCommitEndpoint"
      onsubmit="@SubmitAsync"
      onsubmit:preventDefault>

    <input type="hidden"
           name="@UAuthConstants.Form.ClientProfile"
           value="@ClientProfileValue" />

    <input type="hidden"
           name="@UAuthConstants.Form.Device"
           value="@_deviceId" />

    @if (LoginType == UAuthLoginType.Pkce)
    {
        <input type="hidden"
               name="authorization_code"
               value="@_credentials?.AuthorizationCode" />

        <input type="hidden"
               name="code_verifier"
               value="@_credentials?.CodeVerifier" />

        <input type="hidden"
               name="hub_session_id"
               value="@EffectiveHubSessionId?.Value" />
    }

    <input type="hidden"
           name="@UAuthConstants.Form.ReturnUrl"
           value="@EffectiveReturnUrl" />

    @if (ChildContent is null)
    {
        <div class="uauth-login-fields">
            <div class="uauth-login-field">
                <label for="uauth-identifier">Username</label>
                <input id="uauth-identifier"
                       class="uauth-login-input"
                       name="Identifier"
                       type="text"
                       autocomplete="username"
                       required />
            </div>

            <div class="uauth-login-field">
                <label for="uauth-secret">Password</label>
                <input id="uauth-secret"
                       class="uauth-login-input"
                       name="Secret"
                       type="password"
                       autocomplete="current-password"
                       required />
            </div>

            <button class="uauth-login-submit"
                    type="submit">
                Sign in
            </button>
        </div>
    }
    else
    {
        @ChildContent

        @if (AllowEnterKeyToSubmit)
        {
            <button type="submit"
                    hidden
                    aria-hidden="true">
            </button>
        }
    }
</form>
