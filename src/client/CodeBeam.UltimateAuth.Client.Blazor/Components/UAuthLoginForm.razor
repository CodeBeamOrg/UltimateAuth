@namespace CodeBeam.UltimateAuth.Client.Blazor

@using CodeBeam.UltimateAuth.Client.Options
@using CodeBeam.UltimateAuth.Core.Defaults
@using CodeBeam.UltimateAuth.Core.Contracts
@using Microsoft.Extensions.Options

@inject IJSRuntime JS
@inject IOptions<UAuthClientOptions> Options
@inject NavigationManager Navigation

<form @ref="_form"
      method="post"
      action="@ResolvedCommitEndpoint"
      onsubmit="@SubmitAsync"
      onsubmit:preventDefault>

    <input type="hidden"
           name="@UAuthConstants.Form.ClientProfile"
           value="@ClientProfileValue" />

    <input type="hidden"
           name="@UAuthConstants.Form.Device"
           value="@_deviceId" />

    @if (LoginType == UAuthLoginType.Pkce)
    {
        <input type="hidden"
               name="authorization_code"
               value="@_credentials?.AuthorizationCode" />

        <input type="hidden"
               name="code_verifier"
               value="@_credentials?.CodeVerifier" />

        <input type="hidden"
               name="hub_session_id"
               value="@EffectiveHubSessionId?.Value" />
    }

    <input type="hidden"
           name="@UAuthConstants.Form.ReturnUrl"
           value="@EffectiveReturnUrl" />

    <label for="login-identifier">Username</label>
    <input id="login-identifier"
           name="Identifier"
           type="text"
           autocomplete="username"
           required />

    <label for="login-secret">Password</label>
    <input id="login-secret"
           name="Secret"
           type="password"
           autocomplete="current-password"
           required />

    @ChildContent

    @if (AllowEnterKeyToSubmit)
    {
        <button type="submit"
                hidden
                aria-hidden="true">
        </button>
    }
</form>
