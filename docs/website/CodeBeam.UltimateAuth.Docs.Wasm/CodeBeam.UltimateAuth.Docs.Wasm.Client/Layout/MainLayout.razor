@using CodeBeam.UltimateAuth.Docs.Wasm.Client.Brand
@using CodeBeam.UltimateAuth.Docs.Wasm.Client.Pages
@inherits LayoutComponentBase

@inject NavigationManager Nav

<MudThemeProvider Theme="@_uauthTheme" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a id="uauth" />
<MudLayout>
    <MudAppBar Class="ua-appbar" Color="Color.Transparent" Dense="true" Elevation="0">
        <div class="ua-appbar-grid">

            <div class="ua-left">
                @if (RendererInfo.IsInteractive)
                {
                    <div class="ua-controls-enter">
                        <div class="ua-mobile-only">
                            <MudIconButton Icon="@Icons.Material.Filled.Menu" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
                        </div>

                        <div class="ua-desktop-only">
                            <MudButton Variant="Variant.Text" Href="/docs">Docs</MudButton>
                            <MudButton Variant="Variant.Text" Href="/samples">Samples</MudButton>
                            <MudButton Variant="Variant.Text" Href="/#donate">Donate</MudButton>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ua-nav-shimmer" aria-hidden="true">
                        <span class="ua-nav-shimmer-track"></span>
                    </div>
                }
            </div>

            <a class="ua-center" href="/#uauth" aria-label="UltimateAuth Home">
                <UAuthLogo Class="ua-logo mt-4" Size="64" />
            </a>

            <div class="ua-right">
                @if (RendererInfo.IsInteractive)
                {
                    <div class="ua-controls-enter ua-right-controls">
                        <MudIconButton Icon="@Icons.Custom.Brands.Discord" Color="Color.Primary" Href="https://discord.gg/ENhTkHWcwY" Target="_blank" />
                        <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Primary" Href="https://github.com/CodeBeamOrg/UltimateAuth" Target="_blank" />
                        <MudToggleIconButton @bind-Toggled="_isDarkMode" @bind-Toggled:after="SaveThemeAsync" Icon="@Icons.Material.Filled.DarkMode" ToggledIcon="@Icons.Material.Filled.LightMode" Color="Color.Primary" ToggledColor="Color.Primary" />
                    </div>
                }
                else
                {
                    <div class="ua-nav-shimmer ua-nav-shimmer-right" aria-hidden="true">
                        <span class="ua-nav-shimmer-track"></span>
                    </div>
                }
            </div>

        </div>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Breakpoint="Breakpoint.None" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Temporary">
        <MudNavMenu>
            <MudNavLink Href="/#uauth" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavGroup Icon="@Icons.Material.Filled.Book" Title="Docs" Expanded="false">
                <DocsSidebar Inline="true" />
            </MudNavGroup>
            <MudNavLink Href="/samples" Icon="@Icons.Material.Filled.Apps">Samples</MudNavLink>
            <MudNavLink Href="/#donate" Icon="@Icons.Material.Filled.VolunteerActivism">Donate</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <CascadingValue Value="this" IsFixed="true">
            @Body
        </CascadingValue>
    </MudMainContent>

    
    <MudPaper Square="true"
              Elevation="0"
              Class="ua-footer px-6 py-6">

        <MudContainer MaxWidth="MaxWidth.Large">
            <MudStack Spacing="3">

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" FlexWrap="Wrap.Wrap">

                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle2">
                            <b>UltimateAuth</b>
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Open-source unified Auth for modern .NET.
                        </MudText>
                    </MudStack>

                    <MudStack Row="true" Spacing="2"
                              FlexWrap="Wrap.Wrap">
                        <MudLink Href="/docs" Typo="Typo.caption">Docs</MudLink>
                        <MudLink Href="/samples" Typo="Typo.caption">Samples</MudLink>
                        <MudLink Href="https://github.com/CodeBeamOrg/UltimateAuth"
                                 Target="_blank" Typo="Typo.caption">GitHub</MudLink>
                        <MudLink Href="https://discord.gg/ENhTkHWcwY"
                                 Target="_blank" Typo="Typo.caption">Discord</MudLink>
                    </MudStack>

                </MudStack>

                <MudDivider />

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" FlexWrap="Wrap.Wrap">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        © @DateTime.Now.Year CodeBeam.
                    </MudText>

                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Built for the .NET community.
                    </MudText>
                </MudStack>

            </MudStack>
        </MudContainer>
    </MudPaper>

</MudLayout>

<div class="ua-global-overlay @( _visionOverlay ? "active" : "" )"></div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
