@using CodeBeam.UltimateAuth.Docs.Wasm.Client.Pages
@inherits LayoutComponentBase
@layout MainLayout
@inject NavigationManager Nav

<div class="docs-shell">

    <aside class="docs-sidebar-column">
        <div class="docs-sticky">
            <DocsSidebar />
        </div>
    </aside>

    <main class="docs-main-column">
        @Body
    </main>

    <aside class="docs-toc-column">
        @if (!IsDocsLandingPage)
        {
            <div class="docs-sticky">
                <DocsToc />
                <MudPageContentNavigation SectionClassSelector="mud-scrollspy-section" />
            </div>
        }
    </aside>

</div>

@code {
    private bool IsDocsLandingPage =>
        Nav.ToBaseRelativePath(Nav.Uri)
           .Trim('/')
           .Equals("docs", StringComparison.OrdinalIgnoreCase);
}
