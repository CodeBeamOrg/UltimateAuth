@inject HttpClient Http
@inject NavigationManager Nav
@using System.Net.Http.Json
@implements IDisposable
@inject PersistentComponentState PersistentState

<div style="min-height: 20vh; max-height: 90vh; overflow-y: auto;">
    @if (!Inline)
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="ua-docs-header">
            <div class="ua-docs-brand">
                <MudText Typo="Typo.subtitle1">UltimateAuth</MudText>
                <span>DOCUMENTATION</span>
            </div>
            @* <MudText Typo="Typo.h6" Class="mb-2 px-2">UAuth Docs</MudText> *@

            <MudIconButton Icon="@(HasExpandedGroups ? Icons.Material.Filled.UnfoldLess : Icons.Material.Filled.UnfoldMore)" Color="Color.Default" Size="Size.Small" OnClick="ToggleAllGroups" />
        </MudStack>
    }

    <MudDivider Class="mb-2" />

    @if (!RendererInfo.IsInteractive)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
    }

    @if (_loadFailed)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="px-2 py-3">
            Navigation could not be loaded.
        </MudText>
    }
    else if (_groups is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudNavMenu Color="Color.Primary" Rounded="true" Class="ua-docs-nav">
            <MudNavLink Match="NavLinkMatch.All" Href="/docs" Class="ua-docs-overview">Overview</MudNavLink>
            @foreach (var group in _groups)
            {
                <MudNavGroup @key="group.Key" Title="@FormatGroup(group.Key)" Expanded="@IsGroupExpanded(group.Key)"
                             ExpandedChanged="@(value => SetGroupExpanded(group.Key, value))" Class="ua-docs-group">
                    @foreach (var item in group.Value)
                    {
                        <MudNavLink Match="NavLinkMatch.Prefix" Href="@($"/docs/{item.Slug}")" Class="ua-docs-item">@item.Title</MudNavLink>
                    }
                </MudNavGroup>
            }
        </MudNavMenu>
    }
</div>

@code {
    private Dictionary<string, List<DocIndexItem>>? _groups;
    private bool _loadFailed;

    private PersistingComponentStateSubscription _subscription;

    private string SidebarStateKey => Inline ? "docs-sidebar-inline" : "docs-sidebar-default";

    [Parameter]
    public bool Inline { get; set; }

    private readonly Dictionary<string, bool> _expandedGroups = new();

    private string? _activeGroup;

    private bool IsGroupExpanded(string group)
    {
        return _expandedGroups.TryGetValue(group, out var expanded)
            ? expanded
            : group == _activeGroup;
    }

    private void SetGroupExpanded(string group, bool expanded)
    {
        _expandedGroups[group] = expanded;
        StateHasChanged();
    }

    private void UpdateActiveGroup()
    {
        if (_groups is null)
            return;

        var currentPath = Nav.ToBaseRelativePath(Nav.Uri)
            .Split('?', '#')[0]
            .Trim('/');

        var activeItem = _groups
            .SelectMany(g => g.Value)
            .FirstOrDefault(item =>
                currentPath.Equals(
                    $"docs/{item.Slug.Trim('/')}",
                    StringComparison.OrdinalIgnoreCase));

        var newGroup = activeItem?.Group;

        if (newGroup == _activeGroup)
            return;

        _activeGroup = newGroup;

        if (newGroup is not null)
            _expandedGroups[newGroup] = true;
    }

    protected override void OnInitialized()
    {
        _subscription = PersistentState.RegisterOnPersisting(PersistSidebarAsync);
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            List<DocIndexItem> items;

            if (!PersistentState.TryTakeFromJson<List<DocIndexItem>>(SidebarStateKey, out var cachedItems) || cachedItems is null)
            {
                items = await Http.GetFromJsonAsync<List<DocIndexItem>>("docs/docs-index.json") ?? [];
            }
            else
            {
                items = cachedItems;
            }

            _items = items;

            _groups = items
                .GroupBy(x => x.Group)
                .OrderBy(g => g.Min(x => x.GroupOrder))
                .ToDictionary(
                    g => g.Key,
                    g => g.OrderBy(x => x.Order).ToList()
                );
            UpdateActiveGroup();
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Docs sidebar failed: {ex.Message}");
            _loadFailed = true;
        }
        catch (OperationCanceledException ex)
        {
            Console.WriteLine($"Docs sidebar request canceled: {ex.Message}");
            _loadFailed = true;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            UpdateActiveGroup();
            StateHasChanged();
        });
    }

    private List<DocIndexItem>? _items;

    private Task PersistSidebarAsync()
    {
        if (_items is not null)
        {
            PersistentState.PersistAsJson(SidebarStateKey, _items);
        }

        return Task.CompletedTask;
    }

    private string GetItemClass(DocIndexItem item)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri);

        return current == $"docs/{item.Slug}"
            ? "mud-selected-item"
            : "";
    }

    private string FormatGroup(string group)
    {
        if (string.IsNullOrWhiteSpace(group))
            return "General";

        if (group == "client")
            return "Client SDK";

        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(group.Replace("-", " "));
    }

    private bool HasExpandedGroups => _groups is { Count: > 0 } && _groups.Keys.Any(IsGroupExpanded);

    private void ToggleAllGroups()
    {
        if (_groups is null)
            return;

        bool expand = !HasExpandedGroups;

        foreach (var group in _groups.Keys)
        {
            _expandedGroups[group] = expand;
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _subscription.Dispose();
    }

    private class DocIndexItem
    {
        public string Title { get; set; } = "";
        public string Slug { get; set; } = "";
        public int Order { get; set; }
        public string Group { get; set; } = "";
        public int GroupOrder { get; set; } = 999;
    }
}
