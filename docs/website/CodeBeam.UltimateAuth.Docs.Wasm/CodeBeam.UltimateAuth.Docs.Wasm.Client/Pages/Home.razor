@page "/"
@inject IJSRuntime JS

<MudPage FullScreen="FullScreen.FullWithoutAppbar" Row="1" Column="1">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex align-center justify-center">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h3"><b>UltimateAuth</b></MudText>
            
            <MudText>The
                <span class="ua-gradient">modern unified Auth framework for .NET – Reimagined.</span>
            </MudText>
            
            <MudDivider Class="my-4" />

            <MudText Typo="Typo.subtitle2" Class="mt-4">
                UltimateAuth is an 
                <span style="color: var(--mud-palette-text-secondary)">open-source</span>
                auth framework with platform-level capabilities that unifies secure session, cookie and token based Auth, modern PKCE flows,
                <span style="color: var(--mud-palette-text-secondary)">Blazor/Maui-ready</span>
                client experiences - eliminating the complexity of traditional Auth systems while providing a clean, lightweight, extensible and developer-first architecture.
            </MudText>

            <MudText Class="ua-signature mt-16">A <MudLink Href="https://codebeam.org" Target="_blank">CodeBeam</MudLink> Product</MudText>
        </MudStack>
    </MudContainer>
</MudPage>

<div class="ua-separator"></div>

<MudPage FullScreen="FullScreen.Full" Row="1" Column="1">
    <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex flex-column align-center justify-center">
        <MudStack Spacing="3" Class="text-center ua-vision" Justify="Justify.Center" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.subtitle2" Class="ua-vision-highlight">Vision of UltimateAuth</MudText>
            <MudIcon Class="ua-vision-icon-wrapper mt-n1" Style="width: 72px; height: 72px" Icon="@Icons.Material.Filled.EmojiObjects"
                     Color="Color.Primary" @onmouseenter="() => Layout.SetVisionOverlay(true)"
                     @onmouseleave="() => Layout.SetVisionOverlay(false)" />

            <MudText Typo="Typo.h4" Class="ua-vision-title mt-8">
                AUTHENTICATION IS COMPLEX.<br />
                USING IT SHOULDN’T BE.
            </MudText>

            <MudText Typo="Typo.body1" Class="ua-vision-text">
                Security is not about a single “correct” flow.
                It’s about adapting to context — users, devices, environments and risk.
                Flexibility brings real security.
            </MudText>

            <MudText Typo="Typo.caption" Class="ua-vision-footer">
                Built from real-world Blazor and .NET application needs — not theoretical models.
            </MudText>

            <MudText Typo="Typo.body2" Class="ua-vision-next mt-6">
                Discover how this vision becomes reality — from developer experience to the engineering behind it.
            </MudText>
            
            <div class="ua-vision-scroll-cue" aria-hidden="true">
                <span class="ua-vision-scroll-arrow"></span>
            </div>
        </MudStack>
    </MudContainer>
</MudPage>

<div class="ua-separator"></div>

<MudPage FullScreen="FullScreen.Full" Row="1" Column="1">
    <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex flex-column align-center justify-center">
        <MudStack Spacing="0" Class="mb-8">
            <MudText Typo="Typo.h4"><b>Why UltimateAuth?</b></MudText>
            <MudText Typo="Typo.body1" Class="text-secondary">
                Built for modern .NET applications with simplicity, flexibility and security at its core.
            </MudText>
        </MudStack>

        <MudGrid>
            @foreach (var item in Principles)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Outlined="true" Class="pa-6 h-100 ua-card">
                        <MudStack Spacing="2">
                            <MudIcon Icon="@item.Icon" Size="Size.Large" Color="Color.Primary" />

                            <MudText Typo="Typo.subtitle1">
                                <b>@item.Title</b>
                            </MudText>

                            <MudText Typo="Typo.body2" Class="text-secondary">
                                @item.Description
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </MudContainer>
</MudPage>

<div class="ua-separator"></div>

<section class="ua-engineering-section"
         aria-labelledby="ua-engineering-heading">

    <MudContainer MaxWidth="MaxWidth.Large">

        <div class="ua-engineering-heading">
            <MudText Typo="Typo.overline"
                     Class="ua-engineering-eyebrow">
                UNDER THE HOOD
            </MudText>

            <MudText Typo="Typo.h3"
                     id="ua-engineering-heading"
                     Class="ua-engineering-title">
                <b>Engineered for Trust.</b>
            </MudText>

            <MudText Typo="Typo.body1"
                     Class="ua-engineering-description">
                Beyond simple APIs lies a carefully designed
                foundation for security, consistency and control.
            </MudText>
        </div>

        <MudGrid Spacing="4" Class="ua-engineering-grid">

            <MudItem xs="12" md="6">
                <MudPaper Outlined="true" Class="ua-engineering-panel">

                    <div class="ua-engineering-panel-header">
                        <MudIcon Icon="@Icons.Material.Outlined.Security"
                                 Size="Size.Large"
                                 Color="Color.Primary" />

                        <div>
                            <MudText Typo="Typo.h5">
                                <b>Security</b>
                            </MudText>

                            <MudText Typo="Typo.body2"
                                     Class="text-secondary">
                                Defense at every authentication boundary.
                            </MudText>
                        </div>
                    </div>

                    <div class="ua-engineering-features">

                        @foreach (var feature in SecurityFeatures)
                        {
                            <div class="ua-engineering-feature">
                                <div class="ua-engineering-feature-mark">
                                    <MudIcon Icon="@Icons.Material.Outlined.Check"
                                             Size="Size.Small" />
                                </div>

                                <div class="ua-engineering-feature-content">
                                    <MudText Typo="Typo.subtitle2">
                                        @feature.Title
                                    </MudText>

                                    <MudText Typo="Typo.body2"
                                             Class="text-secondary">
                                        @feature.Description
                                    </MudText>
                                </div>
                            </div>
                        }

                    </div>

                    <div class="ua-engineering-panel-footer">
                        <MudLink Href="/docs/security/session-security"
                                 Typo="Typo.body2"
                                 Color="Color.Primary">
                            Explore Security
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                     Size="Size.Small" />
                        </MudLink>
                    </div>

                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Outlined="true"
                          Class="ua-engineering-panel">

                    <div class="ua-engineering-panel-header">
                        <MudIcon Icon="@Icons.Material.Outlined.AccountTree"
                                 Size="Size.Large"
                                 Color="Color.Primary" />

                        <div>
                            <MudText Typo="Typo.h5">
                                <b>Reliability & Control</b>
                            </MudText>

                            <MudText Typo="Typo.body2"
                                     Class="text-secondary">
                                Consistent operations. Predictable lifecycles.
                            </MudText>
                        </div>
                    </div>

                    <div class="ua-engineering-features">

                        @foreach (var feature in EngineeringFeatures)
                        {
                            <div class="ua-engineering-feature">
                                <div class="ua-engineering-feature-mark">
                                    <MudIcon Icon="@Icons.Material.Outlined.Check"
                                             Size="Size.Small" />
                                </div>

                                <div class="ua-engineering-feature-content">
                                    <MudText Typo="Typo.subtitle2">
                                        @feature.Title
                                    </MudText>

                                    <MudText Typo="Typo.body2"
                                             Class="text-secondary">
                                        @feature.Description
                                    </MudText>
                                </div>
                            </div>
                        }

                    </div>

                    <div class="ua-engineering-panel-footer">
                        <MudLink Href="/docs/fundamentals/runtime-architecture"
                                 Typo="Typo.body2"
                                 Color="Color.Primary">
                            Explore Architecture
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                     Size="Size.Small" />
                        </MudLink>
                    </div>

                </MudPaper>
            </MudItem>

        </MudGrid>

        <MudText Typo="Typo.caption"
                 Class="ua-engineering-footnote">
            Capabilities depend on authentication mode and
            configured providers. See the documentation
            for supported configurations and implementation details.
        </MudText>

    </MudContainer>
</section>


<div class="ua-separator"></div>

<a id="identity-lab" />

<section class="ua-lab-section" aria-labelledby="ua-lab-heading">
    <MudContainer MaxWidth="MaxWidth.Large">

        <div class="ua-lab-showcase">

            <div class="ua-lab-ambient ua-lab-ambient-one"></div>
            <div class="ua-lab-ambient ua-lab-ambient-two"></div>

            <div class="ua-lab-content">

                <div class="ua-lab-heading">

                    <div class="ua-lab-eyebrow">
                        <span class="ua-lab-status-dot"></span>
                        LIVE INTERACTIVE SANDBOX
                    </div>

                    <MudText Typo="Typo.h2"
                             Class="ua-lab-title"
                             id="ua-lab-heading">
                        Meet Identity Lab.
                        <span>Authentication, experienced.</span>
                    </MudText>

                    <MudText Typo="Typo.body1"
                             Class="ua-lab-description my-2">
                        Go beyond documentation and code samples.
                        Explore UltimateAuth inside a real, interactive Blazor application.
                    </MudText>

                    <MudText Typo="Typo.body1"
                             Class="ua-lab-description my-2">
                        Create your own sandbox, manage identities, inspect sessions, experiment with credentials
                        and explore authorization — all powered by UltimateAuth.
                    </MudText>
                </div>

                <MudGrid Spacing="3" Class="ua-lab-features">

                    <MudItem xs="12" sm="6" md="3">
                        <div class="ua-lab-feature">
                            <MudIcon Icon="@Icons.Material.Outlined.Groups"
                                     Size="Size.Large" />
                            <div class="ua-lab-feature-title">
                                Identity Management
                            </div>
                            <div class="ua-lab-feature-text">
                                Explore users, profiles and identifiers.
                            </div>
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <div class="ua-lab-feature">
                            <MudIcon Icon="@Icons.Material.Outlined.Devices"
                                     Size="Size.Large" />
                            <div class="ua-lab-feature-title">
                                Session Lifecycle
                            </div>
                            <div class="ua-lab-feature-text">
                                Discover device-aware sessions and
                                session lineage.
                            </div>
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <div class="ua-lab-feature">
                            <MudIcon Icon="@Icons.Material.Outlined.Key"
                                     Size="Size.Large" />
                            <div class="ua-lab-feature-title">
                                Credentials
                            </div>
                            <div class="ua-lab-feature-text">
                                Experience credential management
                                and account security.
                            </div>
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <div class="ua-lab-feature">
                            <MudIcon Icon="@Icons.Material.Outlined.AdminPanelSettings"
                                     Size="Size.Large" />
                            <div class="ua-lab-feature-title">
                                Authorization
                            </div>
                            <div class="ua-lab-feature-text">
                                Explore roles, permissions and
                                policy-driven access.
                            </div>
                        </div>
                    </MudItem>

                </MudGrid>

                <div class="ua-lab-actions">

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               Href="https://lab.ultimateauth.com"
                               Target="_blank"
                               EndIcon="@Icons.Material.Filled.OpenInNew"
                               Class="ua-lab-primary-button">
                        Launch Identity Lab
                    </MudButton>

                    <MudButton Variant="Variant.Text"
                               Color="Color.Inherit"
                               Size="Size.Large"
                               Href="/docs"
                               EndIcon="@Icons.Material.Filled.ArrowForward"
                               Class="ua-lab-secondary-button">
                        Explore Documentation
                    </MudButton>

                </div>

                <div class="ua-lab-footnote">
                    <MudIcon Icon="@Icons.Material.Outlined.Info"
                             Size="Size.Small" />
                    <span>
                        Identity Lab is a demonstration environment.
                        Use test data only. Sandbox data may be reset.
                    </span>
                </div>

            </div>
        </div>

    </MudContainer>
</section>


<div class="ua-separator"></div>

<MudPage FullScreen="FullScreen.Full" Row="1" Column="1">
    <MudContainer MaxWidth="MaxWidth.Large"
                  Class="d-flex flex-column align-center justify-center">

        <MudStack Spacing="2" Class="text-center mb-8">
            <MudText Typo="Typo.h4">
                <b>Explore UltimateAuth</b>
            </MudText>

            <MudText Typo="Typo.body1" Class="text-secondary">
                From documentation to working examples —
                discover how UltimateAuth fits into your applications.
            </MudText>
        </MudStack>

        <MudGrid Spacing="3" Class="w-100">

            <MudItem xs="12" md="6">
                <MudPaper Outlined="true"
                          Class="pa-6 h-100 ua-card">
                    <MudStack Spacing="3">
                        <MudIcon Icon="@Icons.Material.Outlined.MenuBook"
                                 Size="Size.Large"
                                 Color="Color.Primary" />

                        <MudText Typo="Typo.h6">
                            <b>Documentation</b>
                        </MudText>

                        <MudText Typo="Typo.body2"
                                 Class="text-secondary">
                            Understand the architecture, authentication
                            flows, security model and integration patterns.
                        </MudText>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Href="/docs"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            Read the Docs
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Outlined="true"
                          Class="pa-6 h-100 ua-card">
                    <MudStack Spacing="3">
                        <MudIcon Icon="@Icons.Material.Outlined.Code"
                                 Size="Size.Large"
                                 Color="Color.Primary" />

                        <MudText Typo="Typo.h6">
                            <b>Working Samples</b>
                        </MudText>

                        <MudText Typo="Typo.body2"
                                 Class="text-secondary">
                            Explore real implementations across Blazor Server,
                            WebAssembly, UAuthHub and Resource APIs.
                        </MudText>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Href="/samples"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            Explore Samples
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>

        </MudGrid>

        <MudButton Class="mt-8"
                   Variant="Variant.Text"
                   Color="Color.Default"
                   Href="https://github.com/CodeBeamOrg/UltimateAuth"
                   Target="_blank"
                   StartIcon="@Icons.Custom.Brands.GitHub"
                   EndIcon="@Icons.Material.Filled.OpenInNew">
            Explore the Source on GitHub
        </MudButton>

    </MudContainer>
</MudPage>


<div class="ua-separator"></div>

<a id="donate" />
<MudPage FullScreen="FullScreen.Full" Row="1" Column="1">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex align-center justify-center text-center">
        <MudStack Spacing="4" AlignItems="AlignItems.Center">
            <MudIcon Class="ua-vision-icon-wrapper mt-n1" Style="width: 72px; height: 72px" Icon="@Icons.Material.Filled.VolunteerActivism" />

            <MudText Typo="Typo.h5"><b>UltimateAuth is, and will always remain free.</b></MudText>
            <MudText Class="ua-donate-text">No licenses. No tiers. No hidden limits. Full features as a self-hosted framework.</MudText>
            <MudText Class="ua-donate-subtext">
                But building and maintaining a secure, production-ready Auth framework takes time, effort and care.
            </MudText>
            <MudText>While UltimateAuth secures your applications, you can secure its future.</MudText>

            <MudText Class="ua-donate-subtext">If you believe in this vision, consider supporting the project.</MudText>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="https://github.com/sponsors/CodeBeamOrg" Target="_blank">
                Support the Project
            </MudButton>
        </MudStack>
    </MudContainer>
</MudPage>

@code {
    private List<Principle> Principles = new()
    {
        new(Icons.Material.Outlined.Diversity2, "Unified Auth Model",
            "Stop choosing between cookies, tokens or sessions. UltimateAuth unifies them into a single model — no more fragmented authentication logic."),

        new(Icons.Material.Outlined.Adjust, "Zero Auth Boilerplate",
            "Authentication just works. No manual cookie handling, no token plumbing — UltimateAuth handles it for you."),

        new(Icons.Material.Outlined.Devices, "Device-Aware Sessions",
            "Understand and control user sessions across devices with a built-in Root, Chain and Session model."),

        new(Icons.Material.Outlined.AddModerator, "Modern Security",
            "Built-in PKCE, secure flows and extensible validation pipelines — secure by default, not by configuration."),

        new(Icons.Material.Outlined.Assistant, "Flexible Modes",
            "PureOpaque, Hybrid, SemiHybrid and PureJwt modes allow adapting to different architectures."),

        new(Icons.Material.Outlined.DashboardCustomize, "Extensible",
            "Override any part of the pipeline without breaking security boundaries."),

        new(Icons.Material.Outlined.Category, "Developer First",
            "Clean APIs, Blazor native design and seamless integration with .NET ecosystem."),

        new(Icons.Material.Outlined.AccountTree, "Enterprise-Ready Foundations",
            "Built-in multi-tenancy, soft delete and optimistic concurrency support. Designed with real-world data integrity and scalability in mind."),

        new(Icons.Material.Outlined.Groups, "Advanced User Management",
            "Support for multi-profile and multi-identifier users with a full lifecycle model. Go beyond basic identity systems with flexible, real-world user modeling.")
    };

    private readonly record struct TechnicalFeature(
        string Title,
        string Description);

    private readonly List<TechnicalFeature> SecurityFeatures =
    [
        new(
        "Argon2id Password Hashing",
        "Memory-hard credential protection."),

        new(
            "Dummy Password Verification",
            "Reduced login timing differences."),

        new(
            "CSRF & Antiforgery Protection",
            "Protected state-changing authentication flows."),

        new(
            "PKCE (S256)",
            "Proof-bound authorization flows."),

        new(
            "Refresh Rotation & Reuse Detection",
            "Replay-aware credential renewal."),

        new(
            "Account & Factor Lockout",
            "Configurable failed-attempt protection."),

        new(
            "Rate Limiting",
            "Endpoint and request abuse protection."),

        new(
            "Concurrency Limiting",
            "Bounded expensive hashing operations."),

        new(
            "Password Policies & History",
            "Configurable validation and reuse prevention."),

        new(
            "Secure Credential Recovery",
            "Expiring, single-use recovery proofs."),

        new(
            "Policy-Based Authorization",
            "Roles, permissions and contextual decisions."),

        new(
            "Tenant & Actor Isolation",
            "Explicit security and ownership boundaries.")
    ];

    private readonly List<TechnicalFeature> EngineeringFeatures =
    [
        new(
        "Atomic Operations",
        "Coordinated transactional state changes."),

        new(
            "Optimistic Concurrency",
            "Version-aware conflict detection."),

        new(
            "Soft Delete",
            "Explicit, non-destructive account lifecycle."),

        new(
            "Session Lineage",
            "Root, Chain and Session lifecycle tracking."),

        new(
            "Multi-Identifier Identity Model",
            "Independent identifiers and ownership rules."),

        new(
            "Structured User Profiles",
            "Profile metadata and validation boundaries."),

        new(
            "Pluggable Persistence",
            "In-memory and EF Core implementations."),

        new(
            "Extensible Credential Providers",
            "Provider-based credential validation."),

        new(
            "Client Profile Resolution",
            "Context-aware authentication integration.")
    ];

    record Principle(string Icon, string Title, string Description);

    [CascadingParameter]
    public MainLayout Layout { get; set; } = default!;
}
