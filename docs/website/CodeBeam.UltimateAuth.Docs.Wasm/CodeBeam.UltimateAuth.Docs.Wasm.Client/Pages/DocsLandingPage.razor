@page "/docs"
@layout DocsLayout

<MudPage FullScreen="FullScreen.FullWithoutAppbar" Row="1" Column="1">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-12">
        <MudStack Spacing="5">

            <!-- Hero -->
            <MudStack Spacing="2" Class="text-center mb-4">
                <MudText Typo="Typo.overline" Color="Color.Primary">
                    ULTIMATEAUTH DOCUMENTATION
                </MudText>

                <MudText Typo="Typo.h3">
                    <b>Authentication, unified.</b>
                </MudText>

                <MudText Typo="Typo.subtitle1">
                    Everything you need to build, integrate, and understand authentication with UltimateAuth.
                </MudText>
            </MudStack>

            <!-- Primary starting point -->
            <MudPaper Outlined="true" Class="pa-6" Style="background: transparent">
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Outlined.RocketLaunch" Color="Color.Primary" Size="Size.Large" /> <MudText Typo="Typo.h5">
                            New to UltimateAuth? Start here.
                        </MudText>
                    </MudStack>

                    <MudText Typo="Typo.body1">
                        Build your first working authentication application with a guided Quick Start.
                        Get familiar with the framework before exploring its architecture.
                    </MudText>

                    <MudStack Class="mud-width-full" Row="true" Justify="Justify.SpaceBetween">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Outlined.ArrowForward" Href="/docs/getting-started/quickstart">
                            Start Quick Start
                        </MudButton>

                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/docs/getting-started/index">
                            Getting Started Guide
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>

            <!-- Two learning paths -->
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudPaper Outlined="true" Class="pa-5" Style="height:100%; background:transparent">
                        <MudStack Spacing="3">
                            <MudIcon Icon="@Icons.Material.Outlined.Extension" Color="Color.Primary" Size="Size.Large" />

                            <MudText Typo="Typo.h6">
                                Build &amp; Integrate
                            </MudText>

                            <MudText Typo="Typo.body2">
                                Set up UltimateAuth for Blazor Server,
                                WebAssembly, Resource APIs, and real-world
                                application architectures.
                            </MudText>

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       EndIcon="@Icons.Material.Outlined.ArrowForward"
                                       Href="/docs/getting-started/real-world-setup">
                                Explore Setup Guides
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Outlined="true" Class="pa-5" Style="height:100%; background:transparent">
                        <MudStack Spacing="3">
                            <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Color="Color.Primary" Size="Size.Large" />
                            <MudText Typo="Typo.h6">Understand the Architecture</MudText>

                            <MudText Typo="Typo.body2">
                                Learn the unified authentication model, flows, authentication modes, client profiles,
                                and runtime behavior.
                            </MudText>

                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" EndIcon="@Icons.Material.Outlined.ArrowForward" Href="/docs/fundamentals/overview">
                                Explore Fundamentals
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <!-- Secondary navigation -->
            <MudText Typo="Typo.h5" Class="mt-4">
                Explore by Topic
            </MudText>

            <MudText Typo="Typo.body2">
                Looking for something specific? Go directly to the documentation section you need.
            </MudText>

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudPaper Outlined="true" Class="pa-4" Style="background:transparent">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">
                                Authentication Flows
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Login, refresh, logout, and session lifecycle.
                            </MudText>
                            <MudLink Href="/docs/auth-flows/overview">
                                Explore Auth Flows →
                            </MudLink>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudPaper Outlined="true" Class="pa-4" Style="background:transparent">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">
                                Client &amp; API
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Client APIs, integration, and application usage.
                            </MudText>
                            <MudLink Href="/docs/client-sdk/overview">
                                Explore Client APIs →
                            </MudLink>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudPaper Outlined="true" Class="pa-4" Style="background:transparent">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">
                                Plugin Domains
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Users, credentials, authorization, and policies.
                            </MudText>
                            <MudLink Href="/docs/plugin-domains/overview">
                                Explore Plugin Domains →
                            </MudLink>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudPaper Outlined="true" Class="pa-4" Style="background:transparent">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">
                                Security
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Session security, token protection, refresh rotation, and security policies.
                            </MudText>
                            <MudLink Href="/docs/security/session-security">
                                Explore Security →
                            </MudLink>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Justify="Justify.Center" Class="mt-4">
                <MudButton Variant="Variant.Text" Color="Color.Default" Href="https://github.com/CodeBeamOrg/UltimateAuth/tree/dev/docs/content" Target="_blank" StartIcon="@Icons.Material.Outlined.Code">
                    View Documentation Source
                </MudButton>
            </MudStack>

        </MudStack>
    </MudContainer>
</MudPage>
