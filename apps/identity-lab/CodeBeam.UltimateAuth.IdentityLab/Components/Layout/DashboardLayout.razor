@inherits LayoutComponentBase
@implements IDisposable
@using CodeBeam.UltimateAuth.Core.Runtime
@inject LabDashboardService DashboardService
@inject IUAuthClient UAuthClient
@inject DarkModeManager DarkModeManager
@inject ISnackbar Snackbar
@inject IUAuthProductInfoProvider ProductInfoProvider

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<MudLayout Class="lab-dashboard-layout">
    <div class="lab-appbar-host">
        <MudAppBar Color="Color.Inherit" Elevation="0" Fixed="true" Class="lab-dashboard-appbar">

            <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" Color="Color.Inherit" Class="lab-mobile-menu" OnClick="@(() => _drawerOpen = !_drawerOpen)" />

            <a href="/dashboard" class="lab-dashboard-brand">
                <span class="lab-dashboard-brand-icon">
                    <MudImage Src="identity-lab.png" Height="36" Width="36" />
                </span>
                <span>
                    <strong>Identity Lab</strong>
                    <small>Sandbox Workspace</small>
                </span>
            </a>

            <MudSpacer />

            <MudTooltip Text="@(DarkModeManager.IsDarkMode ? "Light mode" : "Dark mode")" Delay="300">
                <MudIconButton Icon="@(DarkModeManager.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="DarkModeManager.ToggleAsync" />
            </MudTooltip>

            <MudTooltip Text="View source on GitHub" Delay="300">
                <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Href="https://github.com/CodeBeamOrg/UltimateAuth" Target="_blank" Color="Color.Inherit" />
            </MudTooltip>

            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" PopoverClass="lab-profile-menu">

                <ActivatorContent>
                    <MudAvatar Color="Color.Primary" Size="Size.Medium" Class="ml-3 lab-profile-avatar" @onclick="@context.ToggleAsync">
                        @AvatarInitials
                    </MudAvatar>
                </ActivatorContent>

                <ChildContent>
                    <div class="lab-profile-menu-header">
                        <MudAvatar Color="Color.Primary" Size="Size.Medium" Class="lab-profile-menu-avatar">
                            @AvatarInitials
                        </MudAvatar>

                        <div class="lab-profile-menu-user">
                            <div class="lab-profile-menu-name">
                                @DisplayName
                            </div>

                            <div class="lab-profile-menu-username">
                                @@ @UserName
                            </div>
                        </div>
                    </div>
                    
                    <MudDivider Class="my-2" />

                    <MudMenuItem Icon="@Icons.Material.Outlined.VerifiedUser" Disabled="_authOperationBusy" OnClick="ValidateSessionAsync">
                        Validate Session
                    </MudMenuItem>

                    <MudMenuItem Icon="@Icons.Material.Outlined.Refresh" Disabled="_authOperationBusy" OnClick="RefreshSessionAsync">
                        Refresh Session
                    </MudMenuItem>

                    <MudMenuItem Href="/dashboard/session-diagnostics" Icon="@Icons.Material.Outlined.MonitorHeart">
                        Session Diagnostics
                    </MudMenuItem>

                    <MudDivider Class="my-2" />

                    <MudMenuItem Href="/dashboard/identity" Icon="@Icons.Material.Outlined.Badge">
                        My Identity
                    </MudMenuItem>

                    <MudMenuItem Href="/dashboard/sessions" Icon="@Icons.Material.Outlined.Devices">
                        My Sessions
                    </MudMenuItem>

                    <MudDivider Class="my-2" />

                    <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="LogoutAsync">
                        Sign Out
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        </MudAppBar>
    </div>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               Width="252px"
               Elevation="0"
               Class="lab-dashboard-drawer">

        <div class="lab-sidebar-content">

            <div class="lab-sidebar-sandbox">
                <span class="lab-sidebar-sandbox-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Science" />
                </span>
                <div>
                    <strong>@(_sandbox?.SandboxName ?? "My Sandbox")</strong>
                    <small>
                        @(_sandbox is null ? "Identity environment" : $"{_sandbox.MemberCount} / {_sandbox.MaxUsers} users")
                    </small>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
            </div>

            <div class="lab-sidebar-navigation">
                <MudNavMenu>
                    <div class="lab-nav-label">WORKSPACE</div>

                    <UAuthStateView Roles="Ladmin">
                        <MudNavLink Href="/admin" Icon="@Icons.Material.Filled.AdminPanelSettings">
                            Platform Administration
                        </MudNavLink>
                    </UAuthStateView>

                    <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                        Overview
                    </MudNavLink>

                    <div class="lab-nav-label">PERSONAL</div>

                    <MudNavLink Href="/dashboard/identity" Icon="@Icons.Material.Filled.Badge">
                        My Identity
                    </MudNavLink>

                    <MudNavLink Href="/dashboard/sessions" Icon="@Icons.Material.Filled.Devices">
                        My Sessions
                    </MudNavLink>

                    <MudNavLink Href="/dashboard/session-diagnostics" Icon="@Icons.Material.Filled.MonitorHeart">
                        Session Diagnostics
                    </MudNavLink>

                    <MudNavLink Href="/dashboard/access" Icon="@Icons.Material.Filled.VerifiedUser">
                        My Access
                    </MudNavLink>

                    <MudNavLink Href="/dashboard/authorization-lab" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Security">
                        Authorization Lab
                    </MudNavLink>

                    @if (ShowManagement)
                    {
                        <div class="lab-nav-label">SANDBOX MANAGEMENT</div>

                        <MudNavLink Href="/dashboard/users" Icon="@Icons.Material.Filled.People">
                            Users
                        </MudNavLink>

                        <MudNavLink Href="/dashboard/authorization" Icon="@Icons.Material.Filled.AdminPanelSettings">
                            Authorization
                        </MudNavLink>

                        <MudNavLink Href="/dashboard/activity" Icon="@Icons.Material.Filled.History">
                            Activity
                        </MudNavLink>

                        <MudNavLink Href="/dashboard/settings" Icon="@Icons.Material.Filled.Settings">
                            Settings
                        </MudNavLink>
                    }

                    <MudNavMenu>
                        <MudNavLink Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync">
                            Sign Out
                        </MudNavLink>
                    </MudNavMenu>

                    <div class="lab-nav-label">PLAYGROUND</div>

                    <MudNavLink Href="/dashboard/demo-store" Icon="@Icons.Material.Filled.Storefront">
                        Demo Store
                    </MudNavLink>
                </MudNavMenu>
            </div>

            <div class="lab-sidebar-footer">
                <div class="lab-sidebar-product">
                    <a href="https://ultimateauth.com"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="lab-sidebar-product-brand">

                        <span class="lab-sidebar-product-icon">
                            <MudImage Src="ultimateauth-logo.png" Width="28" Height="28" />
                        </span>

                        <span class="lab-sidebar-product-info">
                            <strong>Powered by UltimateAuth</strong>
                            <small>Identity Lab</small>
                        </span>
                    </a>

                    <div class="lab-sidebar-product-meta">
                        <a href="https://github.com/CodeBeamOrg/UltimateAuth/releases"
                           target="_blank"
                           rel="noopener noreferrer"
                           title="UltimateAuth releases">
                            <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small" />
                            <span>@UltimateAuthVersion</span>
                        </a>

                        <span class="lab-sidebar-product-runtime">
                            <MudIcon Icon="@Icons.Material.Outlined.Code" Size="Size.Small" />
                            <span>.NET @LabVersionInfo.DotNetVersion</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </MudDrawer>

    <MudMainContent Class="lab-dashboard-main">
        @if (AuthState?.Identity?.UserStatus == UserStatus.SelfSuspended)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mx-4 mt-4" Icon="@Icons.Material.Filled.PauseCircleOutline">
                <strong>Account Suspended</strong>

                <MudText Typo="Typo.body2">
                    Your account is currently self-suspended.
                    Most account operations are restricted.
                    Reactivate your account from My Identity → Account Management.
                </MudText>
            </MudAlert>
        }
        else if (AuthState?.Identity?.UserStatus == UserStatus.Suspended || AuthState?.Identity?.UserStatus == UserStatus.Locked)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mx-4 mt-4">
                <MudText Typo="Typo.subtitle2">
                    Your account has been suspended
                </MudText>
                <MudText Typo="Typo.body2">
                    Your account has been suspended/locked by an administrator.
                    Some actions are unavailable.
                    Please contact your system administrator to restore access.
                </MudText>
            </MudAlert>
        }
        @Body
    </MudMainContent>

</MudLayout>
