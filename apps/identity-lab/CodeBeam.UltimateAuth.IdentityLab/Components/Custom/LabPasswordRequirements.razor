@using CodeBeam.UltimateAuth.Credentials.Contracts

@if (Policy is not null)
{
    <div class="lab-password-policy">
        <div class="lab-password-policy-header">
            <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Color="Color.Primary" />
            <span>Password requirements</span>

            <MudTooltip Text="UltimateAuth password policy preset. This is the configured default for this application and can be customized by developers through PasswordPolicyOptions.">
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Outlined"
                         Color="Color.Primary">
                    @Policy.Level
                </MudChip>
            </MudTooltip>
        </div>

        <div class="lab-password-policy-rules">
            @foreach (var rule in Rules)
            {
                <div class="lab-password-policy-rule"
                     @key="rule.Label">
                    <MudIcon Icon="@(rule.Passed ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)"
                             Size="Size.Small"
                             Color="@(rule.Passed ? Color.Success : Color.Default)" />
                    <span class="@(rule.Passed ? "rule-passed" : "")">
                        @rule.Label
                    </span>
                </div>
            }
        </div>

        @if (Policy.CheckCommonPasswords ||
             Policy.CheckUserSimilarity ||
             Policy.CheckPasswordHistory)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Additional security checks are performed when you submit.
            </MudText>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public UAuthPasswordPolicyInfo? Policy { get; set; }

    [Parameter]
    public string? Password { get; set; }

    
    private IEnumerable<(string Label, bool Passed)> Rules
    {
        get
        {
            if (Policy is null)
                yield break;

            var password = Password ?? string.Empty;
            var hasPassword = password.Length > 0;

            yield return (
                $"At least {Policy.MinLength} characters",
                hasPassword && password.Length >= Policy.MinLength);

            yield return (
                $"At most {Policy.MaxLength} characters",
                hasPassword && password.Length <= Policy.MaxLength);

            if (Policy.RequireLetter)
                yield return (
                    "Contains a letter",
                    hasPassword && password.Any(char.IsLetter));

            if (Policy.RequireDigit)
                yield return (
                    "Contains a number",
                    hasPassword && password.Any(char.IsDigit));

            if (Policy.RequireUppercase)
                yield return (
                    "Contains an uppercase letter",
                    hasPassword && password.Any(char.IsUpper));

            if (Policy.RequireLowercase)
                yield return (
                    "Contains a lowercase letter",
                    hasPassword && password.Any(char.IsLower));

            if (Policy.RequireSpecialCharacter)
                yield return (
                    "Contains a special character",
                    hasPassword && password.Any(c => !char.IsLetterOrDigit(c)));
        }
    }
}
