@page "/dashboard/auth/combined"
@using CodeBeam.UltimateAuth.Core.Defaults
@attribute [UAuthAuthorize(Permissions = UAuthActions.Users.QueryAdmin)]
@attribute [Authorize(Roles = "Admin")]

