@page "/login"
@using CodeBeam.UltimateAuth.Core.Contracts
@layout PublicLayout
@inject IUAuthClient UAuthClient
@inject NavigationManager NavigationManager

<PageTitle>Sign In · Identity Lab</PageTitle>

<div class="lab-login-page">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="lab-login-grid">

            <section class="lab-login-form-section">
                <div class="lab-login-form-wrap">

                    <div class="lab-login-intro">
                        <span class="lab-login-eyebrow">
                            <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" />
                            YOUR IDENTITY WORKSPACE
                        </span>

                        <h1>
                            @(AuthState.IsAuthenticated ? "You're signed in." : "Welcome back.")
                        </h1>

                        <p>
                            @(AuthState.IsAuthenticated
                                ? "Continue with your current account or sign out to switch accounts."
                                : "Sign in to continue to your Identity Lab sandbox.")
                        </p>
                    </div>

                    <div class="lab-login-card">
                        @if (AuthState.IsAuthenticated)
                        {
                            <MudStack Spacing="3" AlignItems="AlignItems.Center">

                                <MudAvatar Color="Color.Primary"
                                           Size="Size.Large">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" />
                                </MudAvatar>

                                <MudText Typo="Typo.h6">
                                    @CurrentDisplayName
                                </MudText>

                                @if (!string.IsNullOrWhiteSpace(CurrentUserName))
                                {
                                    <MudText Typo="Typo.body2"
                                             Color="Color.Secondary">
                                        @@ @CurrentUserName
                                    </MudText>
                                }

                                <MudChip T="string"
                                         Color="Color.Success"
                                         Variant="Variant.Outlined"
                                         Size="Size.Small"
                                         Icon="@Icons.Material.Filled.VerifiedUser">
                                    Authenticated Session
                                </MudChip>

                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Large"
                                           FullWidth="true"
                                           OnClick="ContinueToDashboard"
                                           EndIcon="@Icons.Material.Filled.ArrowForward">
                                    Continue to Dashboard
                                </MudButton>

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Default"
                                           Disabled="_signingOut"
                                           OnClick="SignOutAsync"
                                           StartIcon="@Icons.Material.Filled.Logout">
                                    Not you? Sign out
                                </MudButton>

                            </MudStack>
                        }
                        else
                        {
                            <UAuthLoginForm Identifier="@_identifier"
                                            Secret="@_password"
                                            ReturnUrl="/dashboard"
                                            OnTryResult="HandleLoginResult">

                                @if (!string.IsNullOrEmpty(_loginError))
                                {
                                    <MudAlert Severity="Severity.Error" Dense="true">
                                        @_loginError
                                    </MudAlert>
                                }

                                <div class="lab-login-fields">
                                    <MudTextField T="string"
                                                  @bind-Value="_identifier"
                                                  Label="Email or Username"
                                                  Placeholder="Enter your email or username"
                                                  Variant="Variant.Outlined"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
                                                  Required="true"
                                                  Immediate="true" />

                                    <MudPasswordField T="string"
                                                      @bind-Value="_password"
                                                      Label="Password"
                                                      Variant="Variant.Outlined"
                                                      Required="true"
                                                      Immediate="true" />

                                    <MudButton ButtonType="ButtonType.Submit"
                                               Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               FullWidth="true"
                                               Size="Size.Large"
                                               EndIcon="@Icons.Material.Filled.ArrowForward">
                                        Sign In
                                    </MudButton>
                                </div>
                            </UAuthLoginForm>

                            <MudDivider />

                            <div class="lab-login-register mt-4">
                                <span>New to Identity Lab?</span>
                                <MudLink Href="/register" Underline="Underline.Hover">Create a sandbox</MudLink>
                            </div>
                        }
                    </div>

                    <div class="lab-login-note">
                        <MudIcon Icon="@Icons.Material.Filled.VerifiedUser"
                                 Size="Size.Small"
                                 Color="Color.Success" />
                        <span>Secure authentication powered by UltimateAuth</span>
                    </div>

                </div>
            </section>


            <aside class="lab-login-showcase">
                <div class="lab-login-showcase-inner">

                    <div class="lab-login-showcase-label">
                        THE IDENTITY PLAYGROUND
                    </div>

                    <MudText Typo="Typo.h4" Class="lab-login-showcase-title">
                        Your sandbox.
                        <span>Your control.</span>
                    </MudText>

                    <MudText Typo="Typo.body1"
                             Class="lab-login-showcase-description">
                        Experience modern authentication, authorization,
                        and session management in one place.
                    </MudText>

                    <div class="lab-login-feature">
                        <span class="lab-login-feature-icon">
                            <MudIcon Icon="@Icons.Material.Filled.AccountTree" />
                        </span>
                        <div>
                            <strong>Unified Sessions</strong>
                            <p>One consistent model for your authentication lifecycle.</p>
                        </div>
                    </div>

                    <div class="lab-login-feature">
                        <span class="lab-login-feature-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Devices" />
                        </span>
                        <div>
                            <strong>Device Control</strong>
                            <p>Explore active sessions and remote sign-out.</p>
                        </div>
                    </div>

                    <div class="lab-login-feature">
                        <span class="lab-login-feature-icon">
                            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                        </span>
                        <div>
                            <strong>Authorization</strong>
                            <p>Understand roles, permissions, and access decisions.</p>
                        </div>
                    </div>

                    <div class="lab-login-showcase-footer">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                        Built for developers. Open to everyone.
                    </div>

                </div>
            </aside>

        </div>
    </MudContainer>
</div>

@code {
    [CascadingParameter]
    private UAuthState AuthState { get; set; } = default!;

    private string _identifier = string.Empty;
    private string _password = string.Empty;
    private string? _loginError;
    private bool _signingOut;

    private string CurrentDisplayName =>
        AuthState.Identity?.DisplayName
        ?? AuthState.Identity?.PrimaryUserName
        ?? "User";

    private string? CurrentUserName =>
        AuthState.Identity?.PrimaryUserName;

    private void ContinueToDashboard()
    {
        NavigationManager.NavigateTo("/dashboard");
    }

    private async Task SignOutAsync()
    {
        if (_signingOut)
            return;

        _signingOut = true;

        try
        {
            await UAuthClient.Flows.LogoutAsync();
        }
        finally
        {
            _signingOut = false;
        }
    }

    private void HandleLoginResult(IUAuthTryResult result)
    {
        if (result.IsSuccess)
        {
            _loginError = null;
            return;
        }

        _loginError = result.LockoutUntilUtc is not null
            ? "Your account is temporarily locked. Please try again later."
            : "Sign in failed. Please check your credentials.";
    }
}
