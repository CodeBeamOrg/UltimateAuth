@page "/dashboard/sessions"
@layout DashboardLayout
@inject IDialogService DialogService

@* TODO: Enable after authentication integration.
@attribute [UAuthAuthorize]
*@

<PageTitle>My Sessions · Identity Lab</PageTitle>

<div class="lab-sessions-page">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge">

        <div class="lab-sessions-heading">
            <div>
                <span class="lab-sessions-eyebrow">PERSONAL SECURITY</span>
                <h1>My Sessions</h1>
                <p>
                    Explore your devices, authentication sessions,
                    and the UltimateAuth session lifecycle.
                </p>
            </div>

            <MudChip T="string"
                     Color="Color.Info"
                     Variant="Variant.Outlined"
                     Size="Size.Small"
                     Icon="@Icons.Material.Filled.Science">
                Demo Preview
            </MudChip>
        </div>

        <div class="lab-sessions-stats">
            <div class="lab-session-stat">
                <span class="lab-session-stat-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Devices" />
                </span>
                <span>Active sessions</span>
                <strong>2</strong>
                <small>Example session count</small>
            </div>

            <div class="lab-session-stat">
                <span class="lab-session-stat-icon">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" />
                </span>
                <span>Authentication chains</span>
                <strong>2</strong>
                <small>Illustrative chains</small>
            </div>

            <div class="lab-session-stat">
                <span class="lab-session-stat-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Security" />
                </span>
                <span>Security status</span>
                <strong>Active</strong>
                <small>Example state</small>
            </div>
        </div>

        <div class="lab-sessions-section-heading">
            <div>
                <h2>Active Devices</h2>
                <p>
                    Sessions associated with your identity.
                </p>
            </div>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Logout"
                       Disabled="true">
                Revoke Other Sessions
            </MudButton>
        </div>

        <div class="lab-device-list">

            <section class="lab-device-card">
                <span class="lab-device-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Computer"
                             Size="Size.Large" />
                </span>

                <div class="lab-device-main">
                    <div class="lab-device-title">
                        <strong>Windows · Chrome</strong>

                        <MudChip T="string"
                                 Color="Color.Success"
                                 Variant="Variant.Text"
                                 Size="Size.Small"
                                 Icon="@Icons.Material.Filled.CheckCircle">
                            Current Device
                        </MudChip>
                    </div>

                    <p>Example desktop session</p>

                    <div class="lab-device-meta">
                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.Schedule"
                                     Size="Size.Small" />
                            Active now (example)
                        </span>
                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.Fingerprint"
                                     Size="Size.Small" />
                            Password authentication
                        </span>
                    </div>
                </div>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="OpenSessionManagementAsync">
                    Details
                </MudButton>
            </section>

            <section class="lab-device-card">
                <span class="lab-device-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Smartphone"
                             Size="Size.Large" />
                </span>

                <div class="lab-device-main">
                    <div class="lab-device-title">
                        <strong>Mobile · Safari</strong>

                        <MudChip T="string"
                                 Color="Color.Default"
                                 Variant="Variant.Outlined"
                                 Size="Size.Small">
                            Remote Session
                        </MudChip>
                    </div>

                    <p>Example mobile session</p>

                    <div class="lab-device-meta">
                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.Schedule"
                                     Size="Size.Small" />
                            Recently active (example)
                        </span>
                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.Fingerprint"
                                     Size="Size.Small" />
                            Password authentication
                        </span>
                    </div>
                </div>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           Size="Size.Small"
                           Disabled="true">
                    Revoke
                </MudButton>
            </section>

        </div>

        <div class="lab-sessions-section-heading lab-sessions-hierarchy-heading">
            <div>
                <span class="lab-sessions-eyebrow">ULTIMATEAUTH ARCHITECTURE</span>
                <h2>Authentication Hierarchy</h2>
                <p>
                    Understand the relationship between authentication
                    roots, chains, and sessions.
                </p>
            </div>
        </div>

        <div class="lab-hierarchy-layout">

            <section class="lab-sessions-panel">

                <div class="lab-panel-title">
                    <h3>Session Structure</h3>
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree"
                             Color="Color.Primary" />
                </div>

                <div class="lab-hierarchy-tree">

                    <div class="lab-tree-node lab-tree-root">
                        <span class="lab-tree-icon">
                            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" />
                        </span>

                        <div>
                            <strong>Authentication Root</strong>
                            <span>Example authentication origin</span>
                        </div>

                        <MudChip T="string"
                                 Color="Color.Success"
                                 Size="Size.Small"
                                 Variant="Variant.Text">
                            Active
                        </MudChip>
                    </div>

                    <div class="lab-tree-branch">

                        <div class="lab-tree-node">
                            <span class="lab-tree-icon">
                                <MudIcon Icon="@Icons.Material.Filled.AccountTree" />
                            </span>

                            <div>
                                <strong>Chain A</strong>
                                <span>Example desktop chain</span>
                            </div>
                        </div>

                        <div class="lab-tree-leaf">
                            <MudIcon Icon="@Icons.Material.Filled.Computer"
                                     Color="Color.Primary"
                                     Size="Size.Small" />

                            <div>
                                <strong>Session A1</strong>
                                <span>Windows · Chrome</span>
                            </div>

                            <MudChip T="string"
                                     Color="Color.Success"
                                     Variant="Variant.Text"
                                     Size="Size.Small">
                                Current
                            </MudChip>
                        </div>

                        <div class="lab-tree-node">
                            <span class="lab-tree-icon">
                                <MudIcon Icon="@Icons.Material.Filled.AccountTree" />
                            </span>

                            <div>
                                <strong>Chain B</strong>
                                <span>Example mobile chain</span>
                            </div>
                        </div>

                        <div class="lab-tree-leaf">
                            <MudIcon Icon="@Icons.Material.Filled.Smartphone"
                                     Color="Color.Primary"
                                     Size="Size.Small" />

                            <div>
                                <strong>Session B1</strong>
                                <span>Mobile · Safari</span>
                            </div>
                        </div>

                    </div>
                </div>

            </section>

            <section class="lab-sessions-panel">

                <div class="lab-panel-title">
                    <h3>How It Works</h3>
                    <MudIcon Icon="@Icons.Material.Outlined.Info" Color="Color.Primary" />
                </div>

                <div class="lab-explanation-list">

                    <div class="lab-explanation-item">
                        <span class="lab-explanation-number">01</span>
                        <div>
                            <strong>Root</strong>
                            <p>
                                Represents the origin of an authentication
                                relationship.
                            </p>
                        </div>
                    </div>

                    <div class="lab-explanation-item">
                        <span class="lab-explanation-number">02</span>
                        <div>
                            <strong>Chain</strong>
                            <p>
                                Groups related authentication activity
                                within a lifecycle.
                            </p>
                        </div>
                    </div>

                    <div class="lab-explanation-item">
                        <span class="lab-explanation-number">03</span>
                        <div>
                            <strong>Session</strong>
                            <p>
                                Represents a session that can be inspected
                                and managed according to its security context.
                            </p>
                        </div>
                    </div>

                </div>

                <MudAlert Severity="Severity.Info"
                          Variant="Variant.Text"
                          Dense="true"
                          Class="mt-5">
                    This hierarchy is illustrative. The actual structure
                    depends on the authentication mode and session lifecycle.
                </MudAlert>

            </section>

        </div>

        <div class="lab-sessions-section-heading lab-sessions-security-heading">
            <div>
                <h2>Session Security</h2>
                <p>
                    Manage your authentication lifecycle and device access.
                </p>
            </div>
        </div>

        <div class="lab-session-actions">

            <div class="lab-session-action">
                <span class="lab-session-action-icon">
                    <MudIcon Icon="@Icons.Material.Filled.DevicesOther" />
                </span>
                <div>
                    <strong>Revoke other sessions</strong>
                    <p>
                        End other device sessions while keeping
                        your current session.
                    </p>
                </div>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Outlined"
                           Disabled="true">
                    Revoke Others
                </MudButton>
            </div>

            <div class="lab-session-action">
                <span class="lab-session-action-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" />
                </span>
                <div>
                    <strong>Sign out</strong>
                    <p>
                        End your current authenticated session.
                    </p>
                </div>
                <MudButton Color="Color.Error"
                           Variant="Variant.Outlined"
                           Disabled="true">
                    Sign Out
                </MudButton>
            </div>

        </div>

    </MudContainer>
</div>

@code {
    private async Task OpenSessionManagementAsync()
    {
        var parameters = new DialogParameters<SessionDialog>
        {
            { x => x.PreviewMode, true }
        };

        await DialogService.ShowAsync<SessionDialog>(
            "Session Management",
            parameters,
            UAuthDialog.GetDialogOptions(MaxWidth.Large));
    }
}
