@page "/dashboard/settings"
@layout DashboardLayout

@* TODO: Enable sandbox-owner authorization.
@attribute [UAuthAuthorize]
*@

<PageTitle>Sandbox Settings · Identity Lab</PageTitle>

<div class="lab-settings-page">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge">

        <div class="lab-settings-heading">
            <div>
                <span class="lab-settings-eyebrow">SANDBOX MANAGEMENT</span>
                <h1>Sandbox Settings</h1>
                <p>
                    Review your sandbox configuration,
                    membership limits, and security boundaries.
                </p>
            </div>

            <MudChip T="string"
                     Color="Color.Info"
                     Variant="Variant.Outlined"
                     Icon="@Icons.Material.Filled.Science"
                     Size="Size.Small">
                Demo Preview
            </MudChip>
        </div>

        <div class="lab-settings-grid">

            <div class="lab-settings-column">

                <section class="lab-settings-card">
                    <div class="lab-settings-card-heading">
                        <div>
                            <h2>General</h2>
                            <p>Basic information about your sandbox.</p>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Settings"
                                 Color="Color.Primary" />
                    </div>

                    <div class="lab-settings-fields">
                        <MudTextField T="string"
                                      Value="@("My Identity Sandbox")"
                                      Label="Sandbox Name"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true" />

                        <MudTextField T="string"
                                      Value="@("sandbox-demo")"
                                      Label="Sandbox Identifier"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"
                                      HelperText="Example identifier. Real IDs will be generated by the application." />

                        <MudTextField T="string"
                                      Value="@("Alex Morgan")"
                                      Label="Sandbox Owner"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true" />

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="true">
                            Save Changes
                        </MudButton>
                    </div>
                </section>

                <section class="lab-settings-card">
                    <div class="lab-settings-card-heading">
                        <div>
                            <h2>Membership &amp; Capacity</h2>
                            <p>Available identities in this environment.</p>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Groups"
                                 Color="Color.Primary" />
                    </div>

                    <div class="lab-settings-capacity">
                        <div class="lab-settings-capacity-header">
                            <span>Occupied user slots</span>
                            <strong>3 / 4</strong>
                        </div>

                        <MudProgressLinear Value="75"
                                           Rounded="true"
                                           Size="Size.Medium"
                                           Color="Color.Primary"
                                           Class="my-3" />

                        <p>
                            Your sandbox supports up to four accounts,
                            including the owner.
                        </p>
                    </div>

                    <div class="lab-settings-detail-row">
                        <span>Maximum Users</span>
                        <strong>4</strong>
                    </div>

                    <div class="lab-settings-detail-row">
                        <span>Available Slots</span>
                        <strong>1</strong>
                    </div>

                    <div class="lab-settings-detail-row">
                        <span>Membership Model</span>
                        <strong>Owner + Members</strong>
                    </div>

                    <MudButton Href="/dashboard/users"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward"
                               Class="mt-4">
                        Manage Users
                    </MudButton>
                </section>

            </div>

            <div class="lab-settings-column">

                <section class="lab-settings-card">
                    <div class="lab-settings-card-heading">
                        <div>
                            <h2>Security Boundaries</h2>
                            <p>Rules that protect sandbox isolation.</p>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Security"
                                 Color="Color.Primary" />
                    </div>

                    <div class="lab-settings-security-list">

                        <div class="lab-settings-security-item">
                            <span class="lab-settings-security-icon">
                                <MudIcon Icon="@Icons.Material.Filled.Lock" />
                            </span>
                            <div>
                                <strong>Private Sandbox</strong>
                                <p>
                                    Users and resources are scoped to
                                    their own sandbox.
                                </p>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                     Color="Color.Success"
                                     Size="Size.Small" />
                        </div>

                        <div class="lab-settings-security-item">
                            <span class="lab-settings-security-icon">
                                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                            </span>
                            <div>
                                <strong>Scoped Administration</strong>
                                <p>
                                    Owners manage only identities and
                                    resources within their sandbox.
                                </p>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                     Color="Color.Success"
                                     Size="Size.Small" />
                        </div>

                        <div class="lab-settings-security-item">
                            <span class="lab-settings-security-icon">
                                <MudIcon Icon="@Icons.Material.Filled.Group" />
                            </span>
                            <div>
                                <strong>Membership Limit</strong>
                                <p>
                                    A maximum of four accounts prevents
                                    unrestricted sandbox growth.
                                </p>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                     Color="Color.Success"
                                     Size="Size.Small" />
                        </div>

                    </div>

                    <MudAlert Severity="Severity.Info"
                              Variant="Variant.Text"
                              Dense="true"
                              Class="mt-4">
                        These are planned Identity Lab security rules.
                        They must be enforced server-side before launch.
                    </MudAlert>
                </section>

                <section class="lab-settings-card">
                    <div class="lab-settings-card-heading">
                        <div>
                            <h2>Environment</h2>
                            <p>Information about this Identity Lab instance.</p>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Dns"
                                 Color="Color.Primary" />
                    </div>

                    <div class="lab-settings-detail-row">
                        <span>Platform</span>
                        <strong>UltimateAuth</strong>
                    </div>

                    <div class="lab-settings-detail-row">
                        <span>Application</span>
                        <strong>Identity Lab</strong>
                    </div>

                    <div class="lab-settings-detail-row">
                        <span>Hosting Model</span>
                        <strong>Blazor Server</strong>
                    </div>

                    <div class="lab-settings-detail-row">
                        <span>Source</span>
                        <MudLink Href="https://github.com/CodeBeamOrg/UltimateAuth"
                                 Target="_blank"
                                 Underline="Underline.Hover">
                            GitHub Repository
                        </MudLink>
                    </div>
                </section>

            </div>

        </div>

        <section class="lab-settings-card lab-settings-danger">
            <div class="lab-settings-card-heading">
                <div>
                    <h2>Danger Zone</h2>
                    <p>Destructive operations affecting your sandbox.</p>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber"
                         Color="Color.Error" />
            </div>

            <div class="lab-settings-danger-action">
                <div>
                    <strong>Reset Sandbox</strong>
                    <p>
                        Remove sandbox-created resources and restore
                        the environment to its initial configuration.
                    </p>
                </div>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           Disabled="true">
                    Reset Sandbox
                </MudButton>
            </div>

            <div class="lab-settings-danger-action">
                <div>
                    <strong>Delete Sandbox</strong>
                    <p>
                        Permanently delete the sandbox and its associated
                        application resources.
                    </p>
                </div>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           Disabled="true">
                    Delete Sandbox
                </MudButton>
            </div>
        </section>

    </MudContainer>
</div>
