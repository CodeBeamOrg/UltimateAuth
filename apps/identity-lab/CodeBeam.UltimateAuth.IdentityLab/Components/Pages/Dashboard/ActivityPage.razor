@page "/dashboard/activity"
@layout DashboardLayout

@* TODO: Enable sandbox-scoped authorization.
@attribute [UAuthAuthorize]
*@

<PageTitle>Activity · Identity Lab</PageTitle>

<div class="lab-activity-page">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge">

        <div class="lab-activity-heading">
            <div>
                <span class="lab-activity-eyebrow">SANDBOX MANAGEMENT</span>
                <h1>Activity</h1>
                <p>Review identity, session, and authorization activity within your sandbox.</p>
            </div>

            <MudChip T="string"
                     Color="Color.Info"
                     Variant="Variant.Outlined"
                     Icon="@Icons.Material.Filled.Science"
                     Size="Size.Small">
                Demo Preview
            </MudChip>
        </div>

        <div class="lab-activity-stats">
            <div class="lab-activity-stat">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Primary" />
                <span>Recorded Events</span>
                <strong>@_events.Count</strong>
                <small>Example activity records</small>
            </div>

            <div class="lab-activity-stat">
                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" />
                <span>Actors</span>
                <strong>@_events.Select(x => x.Actor).Distinct().Count()</strong>
                <small>Example users</small>
            </div>

            <div class="lab-activity-stat">
                <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Primary" />
                <span>Security Events</span>
                <strong>@_events.Count(x => x.Category == ActivityCategory.Security)</strong>
                <small>Illustrative security activity</small>
            </div>
        </div>

        <section class="lab-activity-panel">

            <div class="lab-activity-panel-heading">
                <div>
                    <h2>Activity Log</h2>
                    <p>Explore events recorded within this sandbox.</p>
                </div>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.FileDownload"
                           Disabled="true">
                    Export
                </MudButton>
            </div>

            <div class="lab-activity-toolbar">
                <MudTextField T="string"
                              @bind-Value="_search"
                              Immediate="true"
                              Placeholder="Search events or users"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="lab-activity-search" />

                <MudSelect T="string"
                           @bind-Value="_category"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="lab-activity-filter">
                    <MudSelectItem Value="@("all")">All categories</MudSelectItem>
                    <MudSelectItem Value="@("identity")">Identity</MudSelectItem>
                    <MudSelectItem Value="@("session")">Session</MudSelectItem>
                    <MudSelectItem Value="@("authorization")">Authorization</MudSelectItem>
                    <MudSelectItem Value="@("security")">Security</MudSelectItem>
                </MudSelect>

                <MudSelect T="string"
                           @bind-Value="_period"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="lab-activity-filter">
                    <MudSelectItem Value="@("all")">All dates</MudSelectItem>
                    <MudSelectItem Value="@("7")">Last 7 days</MudSelectItem>
                    <MudSelectItem Value="@("30")">Last 30 days</MudSelectItem>
                </MudSelect>
            </div>

            <MudTable T="ActivityPreview"
                      Items="@FilteredEvents"
                      Hover="true"
                      Breakpoint="Breakpoint.Sm"
                      RowsPerPage="10"
                      Class="lab-activity-table">

                <HeaderContent>
                    <MudTh>Event</MudTh>
                    <MudTh>Actor</MudTh>
                    <MudTh>Category</MudTh>
                    <MudTh>Date</MudTh>
                    <MudTh Style="text-align:right">Details</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Event">
                        <div class="lab-activity-event">
                            <span class="lab-activity-event-icon">
                                <MudIcon Icon="@GetIcon(context.Category)"
                                         Size="Size.Small" />
                            </span>
                            <div>
                                <strong>@context.Title</strong>
                                <span>@context.Description</span>
                            </div>
                        </div>
                    </MudTd>

                    <MudTd DataLabel="Actor">
                        <span class="lab-activity-actor">@context.Actor</span>
                    </MudTd>

                    <MudTd DataLabel="Category">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined"
                                 Color="@GetColor(context.Category)">
                            @context.Category
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="Date">
                        <span class="lab-activity-date">
                            @context.Timestamp.ToString("MMM dd, yyyy")
                        </span>
                    </MudTd>

                    <MudTd DataLabel="Details">
                        <div class="lab-activity-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="@(() => SelectEvent(context))" />
                        </div>
                    </MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <div class="lab-activity-empty">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff"
                                 Color="Color.Secondary"
                                 Size="Size.Large" />
                        <strong>No matching events</strong>
                        <p>Try adjusting your filters.</p>
                    </div>
                </NoRecordsContent>

                <PagerContent>
                    <MudTablePager />
                </PagerContent>

            </MudTable>
        </section>

        @if (_selectedEvent is not null)
        {
            <section class="lab-activity-details">
                <div class="lab-activity-details-heading">
                    <div>
                        <h2>Event Details</h2>
                        <p>Example activity record</p>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   OnClick="@(() => _selectedEvent = null)" />
                </div>

                <div class="lab-activity-detail-grid">
                    <div><span>Event</span><strong>@_selectedEvent.Title</strong></div>
                    <div><span>Actor</span><strong>@_selectedEvent.Actor</strong></div>
                    <div><span>Category</span><strong>@_selectedEvent.Category</strong></div>
                    <div><span>Timestamp (UTC)</span><strong>@_selectedEvent.Timestamp.ToString("yyyy-MM-dd HH:mm")</strong></div>
                </div>

                <p class="lab-activity-detail-description">
                    @_selectedEvent.Description
                </p>
            </section>
        }

        <MudAlert Severity="Severity.Info"
                  Variant="Variant.Text"
                  Dense="true"
                  Class="mt-5">
            Activity records shown here are illustrative. Production activity
            will require explicit event recording, sandbox isolation, and
            appropriate data retention rules.
        </MudAlert>

    </MudContainer>
</div>

@code {
    private string _search = string.Empty;
    private string _category = "all";
    private string _period = "all";

    private ActivityPreview? _selectedEvent;

    private static readonly DateTime PreviewDate =
        new(2026, 10, 21, 12, 0, 0, DateTimeKind.Utc);

    private readonly List<ActivityPreview> _events =
    [
        new("User Created", "A new member was added to the sandbox.",
            "alex", ActivityCategory.Identity, PreviewDate.AddHours(-2)),

        new("Session Revoked", "A remote session was revoked.",
            "taylor", ActivityCategory.Session, PreviewDate.AddHours(-5)),

        new("Role Updated", "A sandbox role configuration was changed.",
            "alex", ActivityCategory.Authorization, PreviewDate.AddDays(-1)),

        new("Password Changed", "A member updated their credential.",
            "jordan", ActivityCategory.Security, PreviewDate.AddDays(-2)),

        new("User Disabled", "A member account was disabled.",
            "alex", ActivityCategory.Identity, PreviewDate.AddDays(-4)),

        new("Session Created", "A new authenticated session was established.",
            "taylor", ActivityCategory.Session, PreviewDate.AddDays(-9))
    ];

    private IEnumerable<ActivityPreview> FilteredEvents =>
        _events
            .Where(x =>
                (string.IsNullOrWhiteSpace(_search) ||
                 x.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                 x.Description.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                 x.Actor.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
                (_category == "all" ||
                 x.Category.ToString().Equals(_category, StringComparison.OrdinalIgnoreCase)) &&
                (_period == "all" ||
                 (int.TryParse(_period, out var days) &&
                  x.Timestamp >= PreviewDate.AddDays(-days))))
            .OrderByDescending(x => x.Timestamp);

    private void SelectEvent(ActivityPreview item) => _selectedEvent = item;

    private static string GetIcon(ActivityCategory category) => category switch
    {
        ActivityCategory.Identity => Icons.Material.Filled.PersonOutline,
        ActivityCategory.Session => Icons.Material.Filled.Devices,
        ActivityCategory.Authorization => Icons.Material.Filled.Shield,
        ActivityCategory.Security => Icons.Material.Filled.Security,
        _ => Icons.Material.Outlined.Info
    };

    private static Color GetColor(ActivityCategory category) => category switch
    {
        ActivityCategory.Identity => Color.Primary,
        ActivityCategory.Session => Color.Info,
        ActivityCategory.Authorization => Color.Secondary,
        ActivityCategory.Security => Color.Warning,
        _ => Color.Default
    };

    private enum ActivityCategory
    {
        Identity,
        Session,
        Authorization,
        Security
    }

    private sealed record ActivityPreview(
        string Title,
        string Description,
        string Actor,
        ActivityCategory Category,
        DateTime Timestamp);
}
