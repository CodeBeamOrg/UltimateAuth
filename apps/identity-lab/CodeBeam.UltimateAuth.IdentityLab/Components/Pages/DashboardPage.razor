@page "/dashboard"
@layout DashboardLayout

@using CodeBeam.UltimateAuth.Core.Domain
@using CodeBeam.UltimateAuth.IdentityLab.Authorization
@using CodeBeam.UltimateAuth.IdentityLab.Contracts
@using CodeBeam.UltimateAuth.IdentityLab.Services

@attribute [UAuthAuthorize(Roles = "Ladmin,Owner,User")]

@inject LabDashboardService DashboardService
@inject LabOwnerRepairService OwnerRepairService
@inject LabAccessContextProvider ContextProvider
@inject ISnackbar Snackbar

<PageTitle>Overview · Identity Lab</PageTitle>

<div class="lab-overview">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge">

        <div class="lab-overview-heading">
            <div>
                <span class="lab-overview-eyebrow">IDENTITY WORKSPACE</span>
                <h1>Welcome to your sandbox.</h1>
                <p>Review your identity, explore authentication and manage your sandbox with UltimateAuth.</p>
            </div>
        </div>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-6" />
        }
        else if (_dashboard is null)
        {
            @if (_repairStatus?.State == OwnerRepairState.CanRepair)
            {
                <MudPaper Outlined="true" Class="pa-6 my-6">
                    <MudStack Spacing="3">
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                            @_repairStatus.Message
                        </MudAlert>

                        <MudText>
                            Your account is active, but your sandbox setup is incomplete.
                            You can safely complete the setup without creating another account.
                        </MudText>

                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Disabled="_repairing"
                                   OnClick="RepairSandboxAsync">
                            @if (_repairing)
                            {
                                <MudProgressCircular Indeterminate="true"
                                                     Size="Size.Small"
                                                     Class="me-2" />
                            }
                            Complete Sandbox Setup
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }
            else
            {
                <MudAlert Severity="Severity.Warning"
                          Variant="Variant.Outlined"
                          Class="my-6">
                    Your sandbox overview is currently unavailable.
                    @if (_repairStatus?.State == OwnerRepairState.NotEligible)
                    {
                        <span>Please contact the administrator if the problem persists.</span>
                    }
                </MudAlert>
            }
        }
        else
        {
            <!-- MY IDENTITY -->
            <div class="lab-overview-section-title">
                <div>
                    <h2>My Lab</h2>
                    <p>
                        A quick look at your authentication
                        and security context.
                    </p>
                </div>
            </div>

            <div class="lab-overview-stats">

                <div class="lab-stat-card">
                    <span class="lab-stat-icon">
                        <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" />
                    </span>

                    <span class="lab-stat-label">Identity Status</span>

                    <strong>
                        @(IsAuthenticated ? "Authenticated" : "Unauthenticated")
                    </strong>

                    <small>UltimateAuth authentication state</small>
                </div>

                <div class="lab-stat-card">
                    <span class="lab-stat-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Devices" />
                    </span>

                    <span class="lab-stat-label">Authentication Chains</span>

                    <strong>
                        @(_dashboard.ChainCount?.ToString() ?? "—")
                    </strong>

                    <small>Total authentication chains</small>
                </div>

                <div class="lab-stat-card">
                    <span class="lab-stat-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Shield" />
                    </span>

                    <span class="lab-stat-label">My Roles</span>

                    <strong>
                        @(_dashboard.RoleCount?.ToString() ?? "—")
                    </strong>

                    <small>Assigned authorization roles</small>
                </div>

                <div class="lab-stat-card">
                    <span class="lab-stat-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Key" />
                    </span>

                    <span class="lab-stat-label">My Permissions</span>

                    <strong>Explore</strong>

                    <small>Evaluate your access</small>
                </div>

            </div>

            <!-- IDENTITY AND SESSION SUMMARY -->

            <div class="lab-overview-grid">

                <section class="lab-panel">

                    <div class="lab-panel-heading">
                        <div>
                            <h3>Identity Details</h3>
                            <p>
                                Your current authenticated identity.
                            </p>
                        </div>

                        <MudIcon Icon="@Icons.Material.Filled.Badge"
                                 Color="Color.Primary" />
                    </div>

                    <div class="lab-profile">

                        <MudAvatar Color="Color.Primary"
                                   Size="Size.Large">
                            <MudIcon Icon="@Icons.Material.Filled.Person" />
                        </MudAvatar>

                        <div>
                            <strong>
                                @(!string.IsNullOrWhiteSpace(_dashboard.DisplayName)
                                    ? _dashboard.DisplayName
                                    : "My Identity")
                            </strong>

                            <span>
                                @(_dashboard.Email ?? "Authenticated account")
                            </span>
                        </div>

                        <MudSpacer />

                        <MudChip T="string"
                                 Color="Color.Success"
                                 Variant="Variant.Text"
                                 Size="Size.Small">
                            @(_dashboard.AccountStatus ?? "Authenticated")
                        </MudChip>

                    </div>

                    <div class="lab-detail-row">
                        <span>Username</span>
                        <strong>@(_dashboard.Username ?? "—")</strong>
                    </div>

                    <div class="lab-detail-row">
                        <span>Email</span>
                        <strong>@(_dashboard.Email ?? "—")</strong>
                    </div>

                    <div class="lab-detail-row">
                        <span>Sandbox Membership</span>
                        <strong>
                            @(_dashboard.IsOwner ? "Owner" : "Member")
                        </strong>
                    </div>

                    <div class="lab-detail-row">
                        <span>Username</span>
                        <strong>@(_dashboard.Username ?? "—")</strong>
                    </div>

                    <div class="lab-detail-row">
                        <span>Email</span>
                        <strong>@(_dashboard.Email ?? "—")</strong>
                    </div>

                    <div class="lab-detail-row">
                        <span>Sandbox Membership</span>
                        <strong>@(_dashboard.IsOwner ? "Owner" : "Member")</strong>
                    </div>

                    <MudButton Href="/dashboard/identity"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Medium"
                               FullWidth="true"
                               Class="mt-5">
                        Explore My Identity
                    </MudButton>

                </section>

                <section class="lab-panel">

                    <div class="lab-panel-heading">
                        <div>
                            <h3>Current Session</h3>
                            <p>
                                Your active authentication context.
                            </p>
                        </div>

                        <MudIcon Icon="@Icons.Material.Filled.Devices"
                                 Color="Color.Primary" />
                    </div>

                    <div class="lab-session-item">

                        <span class="lab-session-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Computer" />
                        </span>

                        <div>
                            <strong>Current Authentication</strong>
                            <span>
                                Your current UltimateAuth session context
                            </span>
                        </div>

                        <MudSpacer />

                        <MudChip T="string"
                                 Color="Color.Success"
                                 Variant="Variant.Text"
                                 Size="Size.Small">
                            Active
                        </MudChip>

                    </div>

                    <div class="lab-detail-row">
                        <span>Authentication</span>
                        <strong>
                            @(IsAuthenticated ? "Active" : "Unavailable")
                        </strong>
                    </div>

                    <div class="lab-detail-row">
                        <span>Session Management</span>
                        <strong>Available</strong>
                    </div>

                    <MudButton Href="/dashboard/sessions"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Medium"
                               FullWidth="true"
                               Class="mt-5">
                        Manage My Sessions
                    </MudButton>

                </section>

            </div>

            <!-- SANDBOX MANAGEMENT -->
            @if (ShowManagement)
            {
                <div class="lab-overview-section-title lab-management-heading">
                    <div>
                        <span class="lab-overview-eyebrow">
                            SANDBOX MANAGEMENT
                        </span>

                        <h2>Manage your environment</h2>

                        <p>
                            Manage identities, explore authorization,
                            and review activity within your sandbox.
                        </p>
                    </div>
                </div>

                <div class="lab-management-grid">

                    <a href="/dashboard/users"
                       class="lab-management-card">

                        <span class="lab-management-icon">
                            <MudIcon Icon="@Icons.Material.Filled.People" />
                        </span>

                        <strong>Users</strong>

                        <p>
                            Create and manage identities
                            within your sandbox.
                        </p>

                        <span class="lab-management-link">
                            Manage users

                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                     Size="Size.Small" />
                        </span>

                    </a>

                    <a href="/dashboard/authorization"
                       class="lab-management-card">

                        <span class="lab-management-icon">
                            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                        </span>

                        <strong>Authorization</strong>

                        <p>
                            Explore roles, permissions,
                            and access control.
                        </p>

                        <span class="lab-management-link">
                            Explore authorization

                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                     Size="Size.Small" />
                        </span>

                    </a>

                    <a href="/dashboard/activity"
                       class="lab-management-card">

                        <span class="lab-management-icon">
                            <MudIcon Icon="@Icons.Material.Filled.History" />
                        </span>

                        <strong>Activity</strong>

                        <p>
                            Review recent authentication
                            and sandbox activity.
                        </p>

                        <span class="lab-management-link">
                            View activity

                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                     Size="Size.Small" />
                        </span>

                    </a>

                    <a href="/dashboard/settings"
                       class="lab-management-card">

                        <span class="lab-management-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Settings" />
                        </span>

                        <strong>Settings</strong>

                        <p>
                            Review your sandbox configuration,
                            membership, and capacity.
                        </p>

                        <span class="lab-management-link">
                            Sandbox settings

                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                     Size="Size.Small" />
                        </span>

                    </a>

                </div>
            }

            <!-- SANDBOX SUMMARY -->
            <div class="lab-sandbox-banner">
                <div>
                    <strong>@_dashboard.SandboxName</strong>

                    <p>
                        Your isolated Identity Lab environment.
                        Manage up to @_dashboard.MaxUsers accounts, including the owner.
                    </p>
                </div>

                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">
                    @_dashboard.MemberCount / @_dashboard.MaxUsers users
                </MudChip>
            </div>
        }
    </MudContainer>
</div>

@code {

    [CascadingParameter]
    private UAuthState? AuthState { get; set; }

    private LabDashboardSnapshot? _dashboard;

    private UserKey? _loadedUserKey;

    private bool _loading = true;

    private bool IsAuthenticated => AuthState?.Identity?.UserKey is not null;

    private string CurrentUserIdentifier => AuthState?.Identity?.UserKey.Value ?? "Unavailable";

    private OwnerRepairStatus? _repairStatus;
    private bool _repairing;

    private bool ShowManagement =>
        AuthState?.IsInRole(LabRoles.Admin) == true ||
        (AuthState?.IsInRole(LabRoles.Owner) == true &&
         _dashboard?.IsOwner == true);

    protected override async Task OnParametersSetAsync()
    {
        var userKey = AuthState?.Identity?.UserKey;

        if (userKey is null)
        {
            _dashboard = null;
            _loadedUserKey = null;
            _loading = false;
            return;
        }

        if (_loadedUserKey == userKey)
            return;

        _loading = true;

        try
        {
            _dashboard = await DashboardService.GetAsync(userKey.Value);
            _repairStatus = null;

            if (_dashboard is null)
            {
                var context = await ContextProvider.CreateAsync("identitylab.owner.repair.status", "identitylab.sandbox");
                _repairStatus = await OwnerRepairService.GetStatusAsync(context);
            }

            _loadedUserKey = userKey;
        }
        catch (Exception)
        {
            _dashboard = null;
            _repairStatus = null;

            Snackbar.Add("Unable to load your dashboard.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RepairSandboxAsync()
    {
        if (_repairing)
            return;

        _repairing = true;

        try
        {
            var context = await ContextProvider.CreateAsync("identitylab.owner.repair", "identitylab.sandbox");
            var result = await OwnerRepairService.RepairAsync(context);
            Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Warning);

            if (result.Success)
            {
                _repairStatus = null;

                var userKey = AuthState?.Identity?.UserKey;

                if (userKey is not null)
                {
                    _dashboard = await DashboardService.GetAsync(userKey.Value);
                    _loadedUserKey = userKey;
                }
            }
        }
        catch (Exception)
        {
            Snackbar.Add(
                "Unable to complete sandbox setup. Please contact the administrator.",
                Severity.Error);
        }
        finally
        {
            _repairing = false;
        }
    }
}
