@page "/register"
@layout PublicLayout
@inject LabRegistrationService RegistrationService
@inject NavigationManager Navigation

<PageTitle>Create Sandbox · Identity Lab</PageTitle>

<div class="lab-login-page">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="lab-login-grid">

            <section class="lab-login-form-section">
                <div class="lab-login-form-wrap">

                    <div class="lab-login-intro">
                        <span class="lab-login-eyebrow">
                            <MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Small" />
                            GET STARTED
                        </span>

                        <h1>Create your sandbox.</h1>
                        <p>Set up your account and start exploring UltimateAuth in your own workspace.
                        </p>
                    </div>

                    <div class="lab-login-card">

                        @if (_registered)
                        {
                            <MudStack Spacing="3">
                                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                                    <MudText Typo="Typo.h6">Your sandbox is ready!</MudText>
                                    <MudText>Your UltimateAuth account and private sandbox have been created successfully.</MudText>
                                </MudAlert>

                                <MudText>
                                    You can now sign in using your username or email address and password.
                                </MudText>

                                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" EndIcon="@Icons.Material.Filled.Login">
                                    Sign in
                                </MudButton>
                            </MudStack>
                        }
                        else
                        {
                            <MudForm @ref="_form">
                                <div class="lab-login-fields">

                                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                                    {
                                        <MudAlert Severity="@(_requiresRepair ? Severity.Warning : Severity.Error)" Variant="Variant.Outlined">
                                            <MudStack Spacing="2">
                                                <MudText>
                                                    @_errorMessage
                                                </MudText>

                                                @if (_requiresRepair)
                                                {
                                                    <MudText>
                                                        Your account may already exist. Do not register again with the same credentials.
                                                    </MudText>

                                                    <MudText>
                                                        Sign in to check whether your sandbox can be recovered. If recovery is unavailable, contact the administrator.
                                                    </MudText>

                                                    <MudButton Href="/login" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                                                        Go to sign in
                                                    </MudButton>
                                                }
                                            </MudStack>
                                        </MudAlert>
                                    }

                                    <MudText Typo="Typo.subtitle2">
                                        Account credentials
                                    </MudText>

                                    <MudTextField T="string"
                                                  @bind-Value="_username"
                                                  Label="Username"
                                                  Placeholder="Choose a username"
                                                  Variant="Variant.Outlined"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.PersonOutline"
                                                  Required="true"
                                                  RequiredError="Username is required."
                                                  autocomplete="off"
                                                  Disabled="_isSubmitting" />

                                    <MudTextField T="string"
                                                  @bind-Value="_email"
                                                  Label="Email address"
                                                  Placeholder="you@example.com"
                                                  InputType="InputType.Email"
                                                  Variant="Variant.Outlined"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
                                                  Required="true"
                                                  RequiredError="Email address is required."
                                                  Validation="@(new Func<string, string?>(ValidateEmail))"
                                                  Disabled="_isSubmitting" />

                                    <MudPasswordField @bind-Value="_password"
                                                      Label="Password"
                                                      Variant="Variant.Outlined"
                                                      Required="true"
                                                      RequiredError="Password is required."
                                                      Immediate="true"
                                                      autocomplete="new-password"
                                                      Validation="@(new Func<string, string?>(ValidatePassword))"
                                                      Disabled="_isSubmitting" />

                                    <MudPasswordField @bind-Value="_confirmPassword"
                                                      Label="Confirm password"
                                                      Variant="Variant.Outlined"
                                                      Required="true"
                                                      RequiredError="Please confirm your password."
                                                      Immediate="true"
                                                      autocomplete="new-password"
                                                      Validation="@(new Func<string, string?>(ValidateConfirmPassword))"
                                                      Disabled="_isSubmitting" />

                                                      
                                    <MudDivider Class="my-2" />

                                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Disabled="_isSubmitting"
                                               EndIcon="@(_showOptionalFields
                                                    ? Icons.Material.Filled.ExpandLess
                                                    : Icons.Material.Filled.ExpandMore)"
                                               OnClick="@(() => _showOptionalFields = !_showOptionalFields)">
                                        Additional information (Optional)
                                    </MudButton>

                                    <MudCollapse Expanded="_showOptionalFields">
                                        <MudStack Spacing="3" Class="pt-3">

                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField T="string"
                                                                  @bind-Value="_firstName"
                                                                  Label="First name"
                                                                  Variant="Variant.Outlined"
                                                                  Disabled="_isSubmitting" />
                                                </MudItem>

                                                <MudItem xs="12" sm="6">
                                                    <MudTextField T="string"
                                                                  @bind-Value="_lastName"
                                                                  Label="Last name"
                                                                  Variant="Variant.Outlined"
                                                                  Disabled="_isSubmitting" />
                                                </MudItem>
                                            </MudGrid>

                                            <MudDatePicker @bind-Date="_birthDate"
                                                           Label="Date of birth"
                                                           Variant="Variant.Outlined"
                                                           MaxDate="@DateTime.Today"
                                                           DateFormat="yyyy-MM-dd"
                                                           Clearable="true"
                                                           Disabled="_isSubmitting" />

                                        </MudStack>
                                    </MudCollapse>

                                    <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                                        Registration creates an UltimateAuth account and a private sandbox with
                                        your own users, sessions and authorization environment.
                                    </MudAlert>

                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               FullWidth="true"
                                               Size="Size.Large"
                                               Disabled="_isSubmitting"
                                               OnClick="SubmitAsync"
                                               EndIcon="@Icons.Material.Filled.ArrowForward">
                                        @if (_isSubmitting)
                                        {
                                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                                            <span>Creating your sandbox...</span>
                                        }
                                        else
                                        {
                                            <span>Create Sandbox</span>
                                        }
                                    </MudButton>
                                </div>
                            </MudForm>

                            <div class="lab-login-register">
                                <span>Already have an account?</span>
                                <MudLink Href="/login"
                                         Underline="Underline.Hover">
                                    Sign in
                                </MudLink>
                            </div>
                        }
                    </div>

                    <div class="lab-login-note">
                        <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" Color="Color.Success" />
                        <span>
                            Free, open source, and powered by UltimateAuth
                        </span>
                    </div>
                </div>
            </section>

            <aside class="lab-login-showcase">
                <div class="lab-login-showcase-inner">

                    <div class="lab-login-showcase-label">
                        YOUR IDENTITY PLAYGROUND
                    </div>

                    <MudText Typo="Typo.h4" Class="lab-login-showcase-title">
                        Build identities.
                        <span>Explore freely.</span>
                    </MudText>

                    <MudText Typo="Typo.body1"
                             Class="lab-login-showcase-description">
                        Create a private sandbox to experience
                        authentication, sessions, and authorization
                        in a real application.
                    </MudText>

                    <div class="lab-login-feature">
                        <span class="lab-login-feature-icon">
                            <MudIcon Icon="@Icons.Material.Filled.People" />
                        </span>
                        <div>
                            <strong>Your own users</strong>
                            <p>
                                Create and manage up to five sandbox
                                members, including yourself.
                            </p>
                        </div>
                    </div>

                    <div class="lab-login-feature">
                        <span class="lab-login-feature-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Devices" />
                        </span>
                        <div>
                            <strong>Real session management</strong>
                            <p>
                                Explore device sessions, authentication
                                lifecycle, and revocation.
                            </p>
                        </div>
                    </div>

                    <div class="lab-login-feature">
                        <span class="lab-login-feature-icon">
                            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                        </span>
                        <div>
                            <strong>Roles &amp; permissions</strong>
                            <p>
                                Experiment with access control inside
                                your sandbox.
                            </p>
                        </div>
                    </div>

                    <div class="lab-login-showcase-footer">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome"
                                 Size="Size.Small" />
                        Your sandbox. Your experiments.
                    </div>

                </div>
            </aside>

        </div>
    </MudContainer>
</div>

@code {
    private string _username = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;

    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private DateTime? _birthDate;

    private bool _isSubmitting;
    private bool _registered;
    private bool _requiresRepair;
    private bool _showOptionalFields;

    private string? _errorMessage;
    private MudForm? _form;

    private static string? ValidateEmail(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Email address is required.";

        return new System.ComponentModel.DataAnnotations
            .EmailAddressAttribute().IsValid(value)
                ? null
                : "Enter a valid email address.";
    }

    private static string? ValidatePassword(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Password is required.";

        if (value.Length < 8)
            return "Password must be at least 8 characters.";

        return null;
    }

    private string? ValidateConfirmPassword(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Please confirm your password.";

        return value == _password
            ? null
            : "Passwords do not match.";
    }

    private async Task SubmitAsync()
    {
        if (_form is null || _isSubmitting || _registered)
            return;

        _errorMessage = null;
        _requiresRepair = false;

        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        if (_birthDate is { } birthDate &&
            birthDate.Date > DateTime.Today)
        {
            _errorMessage = "Date of birth cannot be in the future.";
            return;
        }

        _isSubmitting = true;

        try
        {
            var request = new LabRegistrationRequest(
                Username: _username.Trim(),
                Email: _email.Trim(),
                Password: _password,
                FirstName: string.IsNullOrWhiteSpace(_firstName)
                    ? null
                    : _firstName.Trim(),
                LastName: string.IsNullOrWhiteSpace(_lastName)
                    ? null
                    : _lastName.Trim(),
                BirthDate: _birthDate is { } date
                    ? DateOnly.FromDateTime(date)
                    : null);

            var result = await RegistrationService.RegisterAsync(request);

            if (!result.IsSuccess)
            {
                _errorMessage = result.ErrorMessage
                    ?? "Registration could not be completed.";

                _requiresRepair = result.RequiresRepair;
                return;
            }

            _registered = true;
        }
        catch (Exception)
        {
            _errorMessage =
                "An unexpected error occurred. If you already submitted " +
                "your registration, try signing in before registering again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
